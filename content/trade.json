  "bodyMarkup": "\r\n\r\n    \r\n     <!-- Header Area Start-->\r\n<header class=\"header-area-3 stiky\">\r\n    <div class=\"container fluid-header-3\">\r\n        <div class=\"row align-items-center\">\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-logo -->\r\n                <div class=\"ca-logo\">\r\n                    <H3>LOGO---</h3>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-6 col-lg-7 d-none d-lg-block\">\r\n                <!-- ca-main-menu -->\r\n                <div class=\"ca-main-menu-3\">\r\n                    <nav class=\"ca-mobile-menu-active-3\">\r\n                        <ul>\r\n                            <li>\r\n                                <a href=\"/\">Home <span></i></span></a>\r\n                            </li>\r\n                            <li><a href=/about/>About Us</a></li>\r\n                            <li>\r\n                                <a href=\"#\">Services<span><i class=\"fa-solid fa-angle-down\"></i></span></a>\r\n                                <ul class=\"sub-menu\">\r\n                                    <li><a href=/travel/>Travel</a></li>\r\n                                    <li><a href=/trade/>Trade</a></li>\r\n                                    <li><a href=/shipping/>Shipping</a></li>\r\n                                </ul>\r\n                            </li>\r\n                            \r\n                            <li>\r\n<a href=\"/faq/\">FAQ<san></span></a>                                \r\n                            </li>\r\n                            <li>                             <a href=\"/contact/\">Contact Us<san></span></a>\r\n</li>\r\n                        </ul>\r\n                    </nav>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-btn -->\r\n                <div class=\"ca-header-action-item d-lg-none text-end\">\r\n                    <button type=\"button\" class=\"ca-offcanvas-toogle\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"16\" viewBox=\"0 0 30 16\">\r\n                            <rect x=\"10\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"5\" y=\"7\" width=\"25\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"10\" y=\"14\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                        </svg>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</header>\r\n<!-- Header area end -->\r\n<!-- offcanvas start -->\r\n<div class=\"ca-offcanvas w-bg\">\r\n    <div class=\"ca-offcanvas-wrapper\">\r\n        <div class=\"ca-offcanvas-header d-flex justify-content-between align-items-center mb-40\">\r\n            <div class=\"ca-offcanvas-logo\">\r\n            </div>\r\n            <div class=\"ca-offcanvas-close\">\r\n                <button class=\"ca-offcanvas-close-toggle\"><i class=\"fal fa-times\"></i></button>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-menu-3 mb-40\">\r\n            <nav>\r\n            </nav>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact mb-40\">\r\n            <a href=\"#\" class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\">Get A Quote <span><i class=\"fa-solid fa-angle-right\"></i></span></a>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact-info mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Contact Info</h3>\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-location-dot\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p>\r\n                        <a href=\"#\">\r\n                            55 Street, 2nd block, 3rd Floor\r\n                            Melbourne, Australia\r\n                        </a>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-phone\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"tel:+0221234568806\">+022 (123) 456 88 06</a></p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-envelope\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"mailto:infocargon@gmail.com\">infoTravlink@gmail.com</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-social mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Follow Us</h3>\r\n            <div class=\"ca-footer-social ca-footer-social-3\">\r\n                <ul>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a></li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"ca-offcanvas-overlay\"></div>\r\n<!-- offcanvas end -->\r\n    \n\n<main class=\"travlink-trade-page\">\n    <section class=\"travlink-trade-hero\" aria-labelledby=\"trade-hero-title\">\n        <div class=\"travlink-trade-hero__content container\">\n            <span class=\"travlink-trade-hero__label\">Trade</span>\n            <h1 id=\"trade-hero-title\">Sourcing done right <span>&mdash;</span><br>from factory floor to final delivery.</h1>\n        </div>\n    </section>\n\n    <section class=\"travlink-trade-services\" aria-labelledby=\"trade-services-title\">\n        <div class=\"container\">\n            <div class=\"travlink-trade-services__layout\">\n                <div class=\"travlink-trade-services__intro\">\n                    <span class=\"travlink-trade-eyebrow\">Trade Services</span>\n                    <h2 id=\"trade-services-title\">From the right supplier <em>to the final delivery.</em></h2>\n                    <img src=\"/img/service/ca-service-bg-2.1.png\" alt=\"International trade and sourcing coordination\">\n                </div>\n                <div class=\"travlink-trade-services__list\">\n                    <article><i class=\"fa-solid fa-box-open\" aria-hidden=\"true\"></i><h3>Product Sourcing</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-handshake\" aria-hidden=\"true\"></i><h3>Supplier Identification</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-shield-halved\" aria-hidden=\"true\"></i><h3>Supplier Verification</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-industry\" aria-hidden=\"true\"></i><h3>Factory Coordination</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-arrow-right-to-bracket\" aria-hidden=\"true\"></i><h3>Import Consultation</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-arrow-right-from-bracket\" aria-hidden=\"true\"></i><h3>Export Consultation</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-users\" aria-hidden=\"true\"></i><h3>Business Networking</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-globe\" aria-hidden=\"true\"></i><h3>International Procurement</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"travlink-trade-support\" aria-label=\"Trade consultation and frequently asked questions\">\n        <div class=\"container\">\n            <div class=\"travlink-trade-support__grid\">\n                <aside class=\"travlink-trade-contact\">\n                    <span class=\"travlink-trade-eyebrow\">Contact Us</span>\n                    <h2>Request Trade <em>Consultation</em></h2>\n                    <form class=\"travlink-trade-contact__form\" action=\"#\">\n                        <input type=\"text\" placeholder=\"Your Name\" aria-label=\"Your Name\">\n                        <input type=\"email\" placeholder=\"Email Address\" aria-label=\"Email Address\">\n                        <input type=\"tel\" placeholder=\"Phone Number\" aria-label=\"Phone Number\">\n                        <textarea rows=\"5\" placeholder=\"Your Message\" aria-label=\"Your Message\"></textarea>\n                        <button class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\" type=\"submit\">Send Inquiry <span><i class=\"fa-solid fa-angle-right\"></i></span></button>\n                    </form>\n                    <div class=\"travlink-trade-contact__socials\" aria-label=\"Social media links\">\n                        <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                        <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                        <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                        <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                    </div>\n                </aside>\n                <div class=\"travlink-trade-faq\">\n                    <div class=\"travlink-trade-faq__heading\">\n                        <span class=\"travlink-trade-eyebrow\">Trade FAQs</span>\n                        <h2>Questions, <em>answered clearly.</em></h2>\n                    </div>\n                    <div class=\"ca-acordion-area travlink-trade-faq__accordion\">\n                        <div class=\"accordion\" id=\"tradeFaqAccordion\">\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"tradeFaqOne\"><button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#tradeFaqOneContent\" aria-expanded=\"true\" aria-controls=\"tradeFaqOneContent\">I've heard stories about people getting scammed by suppliers in China. How do you prevent that?</button></h3>\n                                <div id=\"tradeFaqOneContent\" class=\"accordion-collapse collapse show\" aria-labelledby=\"tradeFaqOne\" data-bs-parent=\"#tradeFaqAccordion\"><div class=\"ca-accordion-body\"><p>That exact fear is why supplier verification is part of what we do &mdash; checking the factory is real and can actually produce what it claims, before you send any money.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"tradeFaqTwo\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#tradeFaqTwoContent\" aria-expanded=\"false\" aria-controls=\"tradeFaqTwoContent\">I'm a first-time importer with a small order &mdash; will you still take that on?</button></h3>\n                                <div id=\"tradeFaqTwoContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"tradeFaqTwo\" data-bs-parent=\"#tradeFaqAccordion\"><div class=\"ca-accordion-body\"><p>Yes. Everyone starts somewhere, and a smaller first order is often how a longer sourcing relationship begins.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"tradeFaqThree\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#tradeFaqThreeContent\" aria-expanded=\"false\" aria-controls=\"tradeFaqThreeContent\">Do you handle communication with the factory, or do I need to?</button></h3>\n                                <div id=\"tradeFaqThreeContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"tradeFaqThree\" data-bs-parent=\"#tradeFaqAccordion\"><div class=\"ca-accordion-body\"><p>We handle it. You shouldn't need to speak Mandarin to get a straight answer from a supplier.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"tradeFaqFour\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#tradeFaqFourContent\" aria-expanded=\"false\" aria-controls=\"tradeFaqFourContent\">Can I get a sample before committing to a bulk order?</button></h3>\n                                <div id=\"tradeFaqFourContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"tradeFaqFour\" data-bs-parent=\"#tradeFaqAccordion\"><div class=\"ca-accordion-body\"><p>In most cases, yes &mdash; sample requests are part of the sourcing process, not an extra ask.</p></div></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</main>\n\r\n    <footer class=\"travlink-footer\">\n    <div class=\"container\">\n        <div class=\"travlink-footer__top\">\n            <div class=\"travlink-footer__brand\">\n                <a class=\"travlink-footer__logo\" href=\"/\" aria-label=\"Travlink Global home\">\n                    <span class=\"travlink-footer__logo-mark\" aria-hidden=\"true\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <span>Travlink Global</span>\n                </a>\n                <p class=\"travlink-footer__description\">Connecting people and businesses across borders through trusted travel, trade, and shipping solutions.</p>\n                <div class=\"travlink-footer__socials\" aria-label=\"Social media links\">\n                    <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                    <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                    <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                    <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                </div>\n            </div>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer quick links\">\n                <h2>Quick Links</h2>\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/about/\">About</a></li>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                    <li><a href=\"/contact/\">Contact</a></li>\n                </ul>\n            </nav>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer services\">\n                <h2>Services</h2>\n                <ul>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                </ul>\n            </nav>\n\n            <div class=\"travlink-footer__column travlink-footer__contact\">\n                <h2>Contact &amp; Legal</h2>\n                <ul>\n                    <li><a href=\"https://wa.me/\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>WhatsApp</a></li>\n                    <li><a href=\"mailto:infotravlinkglobal@gmail.com\"><i class=\"fa-regular fa-envelope\" aria-hidden=\"true\"></i>Travlinkglobal@gmail.com </a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"travlink-footer__bottom\">\n            <p class=\"travlink-footer__copyright\">&copy; 2026 Travlink Global. All rights reserved.</p>\n            <nav class=\"travlink-footer__legal\" aria-label=\"Legal links\">\n                <a href=\"#\">Privacy Policy</a>\n                <a href=\"#\">Terms &amp; Conditions</a>\n            </nav>\n        </div>\n    </div>\n</footer>\n\n\r\n    <button id=\"topBtn3\"><i class=\"fa-solid fa-arrow-up\"></i></button>\r\n    <a class=\"travlink-whatsapp-float\"\n   href=\"https://wa.me/\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\"\n   aria-label=\"Contact Travlink Global on WhatsApp\">\n    <i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>\n</a>\r\n\r\n    <script src=\"/js/jquery-3.7.1.min.js\"></script>\r\n<script src=\"/js/bootstrap.bundle.min.js\"></script>\r\n<script src=\"/js/jquery.magnific-popup.min.js\"></script>\r\n<script src=\"/js/jquery.counterup.min.js\"></script>\r\n<script src=\"/js/slick.min.js\"></script>\r\n<script src=\"/js/jquery.nice-select.js\"></script>\r\n<script src=\"/js/waypoints.min.js\"></script>\r\n<script src=\"/js/aos.js\"></script>\r\n<script src=\"/js/main.js\"></script>\r\n<script src=\"/js/scroll-motion.js\"></script>\r\n<script src=\"/js/mobile-navigation.js\"></script>\r\n\r\n\r\n    \r\n\r\n"
