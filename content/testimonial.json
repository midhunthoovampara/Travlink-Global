  "bodyMarkup": "\r\n\r\n    \r\n     <!-- Header Area Start-->\r\n<header class=\"header-area-3 stiky\">\r\n    <div class=\"container fluid-header-3\">\r\n        <div class=\"row align-items-center\">\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-logo -->\r\n                <div class=\"ca-logo\">\r\n                    <H3>LOGO---</h3>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-6 col-lg-7 d-none d-lg-block\">\r\n                <!-- ca-main-menu -->\r\n                <div class=\"ca-main-menu-3\">\r\n                    <nav class=\"ca-mobile-menu-active-3\">\r\n                        <ul>\r\n                            <li>\r\n                                <a href=\"/\">Home <span></i></span></a>\r\n                            </li>\r\n                            <li><a href=/about/>About Us</a></li>\r\n                            <li>\r\n                                <a href=\"#\">Services<span><i class=\"fa-solid fa-angle-down\"></i></span></a>\r\n                                <ul class=\"sub-menu\">\r\n                                    <li><a href=/travel/>Travel</a></li>\r\n                                    <li><a href=/trade/>Trade</a></li>\r\n                                    <li><a href=/shipping/>Shipping</a></li>\r\n                                </ul>\r\n                            </li>\r\n                            \r\n                            <li>\r\n<a href=\"/faq/\">FAQ<san></span></a>                                \r\n                            </li>\r\n                            <li>                             <a href=\"/contact/\">Contact Us<san></span></a>\r\n</li>\r\n                        </ul>\r\n                    </nav>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-btn -->\r\n                <div class=\"ca-header-action-item d-lg-none text-end\">\r\n                    <button type=\"button\" class=\"ca-offcanvas-toogle\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"16\" viewBox=\"0 0 30 16\">\r\n                            <rect x=\"10\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"5\" y=\"7\" width=\"25\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"10\" y=\"14\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                        </svg>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</header>\r\n<!-- Header area end -->\r\n<!-- offcanvas start -->\r\n<div class=\"ca-offcanvas w-bg\">\r\n    <div class=\"ca-offcanvas-wrapper\">\r\n        <div class=\"ca-offcanvas-header d-flex justify-content-between align-items-center mb-40\">\r\n            <div class=\"ca-offcanvas-logo\">\r\n            </div>\r\n            <div class=\"ca-offcanvas-close\">\r\n                <button class=\"ca-offcanvas-close-toggle\"><i class=\"fal fa-times\"></i></button>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-menu-3 mb-40\">\r\n            <nav>\r\n            </nav>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact mb-40\">\r\n            <a href=\"#\" class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\">Get A Quote <span><i class=\"fa-solid fa-angle-right\"></i></span></a>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact-info mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Contact Info</h3>\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-location-dot\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p>\r\n                        <a href=\"#\">\r\n                            55 Street, 2nd block, 3rd Floor\r\n                            Melbourne, Australia\r\n                        </a>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-phone\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"tel:+0221234568806\">+022 (123) 456 88 06</a></p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-envelope\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"mailto:infocargon@gmail.com\">infoTravlink@gmail.com</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-social mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Follow Us</h3>\r\n            <div class=\"ca-footer-social ca-footer-social-3\">\r\n                <ul>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a></li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"ca-offcanvas-overlay\"></div>\r\n<!-- offcanvas end -->\r\n    \r\n\r\n\n\r\n<main>\r\n    <!-- breadcrumb area start -->\r\n    </section>\r\n    <!-- breadcrumb area end -->\r\n    <div class=\"ca-testimonial-inner pt-100 pb-100\">\n        <div class=\"container\">\n            <header class=\"travlink-inner-intro\">\n                <span class=\"travlink-inner-intro__eyebrow\">Testimonials</span>\n                <h1>Trusted journeys. <em>Shared experiences.</em></h1>\n            </header>\n            <div class=\"row\">\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">&ldquo;Read about how our tailored solutions have helped businesses achieve.&rdquo;</h4>\r\n                            <p>Our clients' satisfaction is our top priority,<br> and their feedback speaks volumes about our dedication to excellence. We take immense <br> pride in the positive experiences shared by businesses across various industries who rely <br> on our transport and logistics expertise.</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testi3.1.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Shevon Daniel</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">&ldquo;Hear from the businesses we support and their journey with our logistics.&rdquo;</h4>\r\n                            <p>At Cargon, client satisfaction is at the heart <br>of everything we do. We are proud to share <br>the positive experiences of our clients, whose testimonials reflect or commitment delivering exceptional transport and logistics solutions whether it's seamless international.</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/testimonial-2.1.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Muhammad Waseem</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">&ldquo;Leading businesses share their success stories and why they rely logistics.&rdquo;</h4>\r\n                            <p>Whether it's seamless international shipping, <br>efficient domestic transport, or specialized <br> logistics services, our clients consistently<br> praise our ability to meet and exceed their expectations. They highlight our innovative approach, reliable execution, & dedicated.</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testi3.2.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Dunith Wellalage</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">&ldquo;Trusted by Businesses Worldwide Testimonials from Industry Leaders&rdquo;</h4>\r\n                            <p>&ldquo;Discover why businesses trust for their <br>transport and logistics needs. Our clients consistently praise our dedication to reliable<br> service, innovative solutions, and exceptional customer support. From handling complex international shipments providing seamless&rdquo;</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testimonial-ier1.1.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Zachary McCaskie</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">\"What Our Clients Say About Our<br> Reliable Logistics Solutions\"</h4>\r\n                            <p>&ldquo;We ensure every logistical challenge is met<br> with precision and care. Hear directly from <br>our satisfied clients about their experiences partnering with us and how our tailored<br> logistics solutions have positively impacted<br> their operations.&rdquo;</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testimonial-ier1.2.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Jason Holder</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">\"Client Feedback On Our Efficient <br> Supply Chain Services\"</h4>\r\n                            <p>&ldquo;From small businesses to large enterprises,<br>our clients appreciate our responsiv<br> customer service and proactive approach to <br>solving logistical challenges. Discover how <br>Cargon can optimize your logistics operations<br> and support your business growth.&rdquo;</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testimonial-ier1.3.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Kavem Hodge</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-testimonial-iner br-7\">\r\n                        <div class=\"ca-test-3-rating\">\r\n                            <div class=\"ca-ratings-3\">\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa fa-star checked star\"></span>\r\n                                <span class=\"fa-solid fa-star-half-stroke checked star\"></span>\r\n                            </div>\r\n                            <div class=\"ca-rating-num-3\">\r\n                                <h4 class=\"ca-rating-title-3\">(4.5)</h4>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"ca-test-3-content\">\r\n                            <h4 class=\"ca-test-title-3\">\"Partner Testimonials On Our Global Shipping Expertise\"</h4>\r\n                            <p>&ldquo;Our clients appreciate our proactive<br> approach to solving logistical challenges,<br> whether it's navigating complex customs<br> processes, optimizing supply chain routes, or ensuring timely deliveries. They value our<br> dedication to understanding their.&rdquo;</p>\r\n                        </div>\r\n                        <div class=\"ca-test-3-user\">\r\n                            <div class=\"ca-test-3-user-img\">\r\n                                <span><img src=\"/img/testimonial/ca-testimonial-ier1.4.png\" alt=\"\"></span>\r\n                            </div>\r\n                            <div class=\"ca-test-3-user-name\">\r\n                                <h4 class=\"test-3-title\"><a href=\"#\">Dan Lawrence</a></h4>\r\n                                <span>Co-Founder</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- single testimonial item -->\r\n                <div class=\"col-xl-4 col-md-6 mb-30\">\r\n                    <div class=\"ca-testimonial-card-3 ca-