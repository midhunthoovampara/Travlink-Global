       </article>\r\n\r\n            <article class=\"travlink-travel-feature travlink-travel-feature--visa\" id=\"visa-assistance\" aria-labelledby=\"visa-title\">\r\n                <div class=\"travlink-travel-feature__content\">\r\n                    <span class=\"travlink-travel-eyebrow\">Visa Assistance</span>\r\n                    <h2 id=\"visa-title\">Getting the paperwork right, <em>the first time.</em></h2>\r\n                    <div class=\"travlink-visa__types\">\n                        <article class=\"travlink-visa-card\"><i class=\"fa-solid fa-passport\" aria-hidden=\"true\"></i><h3>Tourist Visa</h3></article>\n                        <article class=\"travlink-visa-card\"><i class=\"fa-solid fa-briefcase\" aria-hidden=\"true\"></i><h3>Business Visa</h3></article>\n                        <article class=\"travlink-visa-card\"><i class=\"fa-solid fa-plane-departure\" aria-hidden=\"true\"></i><h3>Transit Visa</h3></article>\n                    </div>\n                    <section class=\"travlink-country-showcase\" aria-labelledby=\"visa-country-title\">\n                        <span class=\"travlink-country-showcase__label\">Countries We Assist</span>\n                        <h3 id=\"visa-country-title\">Visa Assistance <em>Across Multiple Destinations</em></h3>\n\n                        <div class=\"travlink-country-carousel\" role=\"region\" aria-label=\"Countries supported for visa assistance\">\n                            <div class=\"travlink-country-carousel__track\">\n                                <div class=\"travlink-country-carousel__group\">\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/qatar.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"Doha waterfront skyline in Qatar\" />\n                                        <span class=\"travlink-country-card__name\">Qatar</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/kuwait.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"The Kuwait Towers in Kuwait City\" />\n                                        <span class=\"travlink-country-card__name\">Kuwait</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/china.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"The Great Wall of China across mountain ridges\" />\n                                        <span class=\"travlink-country-card__name\">China</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/uzbekistan.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"Historic tiled architecture in Samarkand, Uzbekistan\" />\n                                        <span class=\"travlink-country-card__name\">Uzbekistan</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/kazakhstan.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"Bayterek Tower and modern architecture in Astana, Kazakhstan\" />\n                                        <span class=\"travlink-country-card__name\">Kazakhstan</span>\n                                    </article>\n                                    <article class=\"travlink-country-card travlink-country-card--more\">\n                                        <i class=\"fa-solid fa-earth-asia\" aria-hidden=\"true\"></i>\n                                        <span class=\"travlink-country-card__name\">And More<small>Contact us for other destinations</small></span>\n                                    </article>\n                                </div>\n\n                                <div class=\"travlink-country-carousel__group\" aria-hidden=\"true\">\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/qatar.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"\" />\n                                        <span class=\"travlink-country-card__name\">Qatar</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/kuwait.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"\" />\n                                        <span class=\"travlink-country-card__name\">Kuwait</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/china.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"\" />\n                                        <span class=\"travlink-country-card__name\">China</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/uzbekistan.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"\" />\n                                        <span class=\"travlink-country-card__name\">Uzbekistan</span>\n                                    </article>\n                                    <article class=\"travlink-country-card\">\n                                        <img src=\"/img/service/countries/kazakhstan.jpg\" width=\"760\" height=\"500\" loading=\"lazy\" decoding=\"async\" alt=\"\" />\n                                        <span class=\"travlink-country-card__name\">Kazakhstan</span>\n                                    </article>\n                                    <article class=\"travlink-country-card travlink-country-card--more\">\n                                        <i class=\"fa-solid fa-earth-asia\" aria-hidden=\"true\"></i>\n                                        <span class=\"travlink-country-card__name\">And More<small>Contact us for other destinations</small></span>\n                                    </article>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n                <div class=\"travlink-travel-feature__image\">\r\n                    <img src=\"/img/service/visa.jpg\" alt=\"Passport and boarding pass prepared for international travel\" />\r\n                </div>\r\n            </article>\r\n        </div>\r\n    </section>\r\n    <section class=\"travlink-travel-support\" aria-label=\"Travel consultation and frequently asked questions\">\r\n        <div class=\"container\">\r\n            <div class=\"travlink-travel-support__grid\">\r\n                <aside class=\"travlink-travel-contact\">\r\n                    <span class=\"travlink-travel-eyebrow\">Contact Us</span>\r\n                    <h2>Request Travel <em>Consultation</em></h2>\r\n                    <form class=\"travlink-travel-contact__form\" action=\"#\">\r\n                        <input type=\"text\" placeholder=\"Your Name\" aria-label=\"Your Name\">\r\n                        <input type=\"email\" placeholder=\"Email Address\" aria-label=\"Email Address\">\r\n                        <input type=\"tel\" placeholder=\"Phone Number\" aria-label=\"Phone Number\">\r\n                        <textarea rows=\"5\" placeholder=\"Your Message\" aria-label=\"Your Message\"></textarea>\r\n                        <button class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\" type=\"submit\">Send Inquiry <span><i class=\"fa-solid fa-angle-right\"></i></span></button>\r\n                    </form>\r\n                    <div class=\"travlink-travel-contact__socials\" aria-label=\"Social media links\">\r\n                        <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\r\n                        <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\r\n                        <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\r\n                        <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\r\n                    </div>\r\n                </aside>\r\n                <div class=\"travlink-travel-faq\">\r\n                    <div class=\"travlink-travel-faq__heading\">\r\n                        <span class=\"travlink-travel-eyebrow\">Travel FAQs</span>\r\n                        <h2 id=\"travel-faq-title\">Questions, <em>answered clearly.</em></h2>\r\n                    </div>\r\n                    <div class=\"ca-acordion-area travlink-travel-faq__accordion\">                <div class=\"accordion\" id=\"travelFaqAccordion\">\r\n                    <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\r\n                        <h3 class=\"ca-accordion-header\" id=\"travelFaqOne\"><button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#travelFaqOneContent\" aria-expanded=\"true\" aria-controls=\"travelFaqOneContent\">How long does visa processing take?</button></h3>\r\n                        <div id=\"travelFaqOneContent\" class=\"accordion-collapse collapse show\" aria-labelledby=\"travelFaqOne\" data-bs-parent=\"#travelFaqAccordion\"><div class=\"ca-accordion-body\"><p>It depends on the country and visa type &mdash; we'll give you a clear timeline before you apply.</p></div></div>\r\n                    </div>\r\n                    <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\r\n                        <h3 class=\"ca-accordion-header\" id=\"travelFaqTwo\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#travelFaqTwoContent\" aria-expanded=\"false\" aria-controls=\"travelFaqTwoContent\">Do you book flights and hotels together?</button></h3>\r\n                        <div id=\"travelFaqTwoContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"travelFaqTwo\" data-bs-parent=\"#travelFaqAccordion\"><div class=\"ca-accordion-body\"><p>Yes, we can handle your full itinerary in one place.</p></div></div>\r\n                    </div>\r\n                    <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\r\n                        <h3 class=\"ca-accordion-header\" id=\"travelFaqThree\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#travelFaqThreeContent\" aria-expanded=\"false\" aria-controls=\"travelFaqThreeContent\">Can you help with last-minute business travel?</button></h3>\r\n                        <div id=\"travelFaqThreeContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"travelFaqThree\" data-bs-parent=\"#travelFaqAccordion\"><div class=\"ca-accordion-body\"><p>Yes &mdash; reach out and we'll move quickly.</p></div></div>\r\n                    </div>\r\n                    <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\r\n                        <h3 class=\"ca-accordion-header\" id=\"travelFaqFour\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#travelFaqFourContent\" aria-expanded=\"false\" aria-controls=\"travelFaqFourContent\">Do you offer group travel packages?</button></h3>\r\n                        <div id=\"travelFaqFourContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"travelFaqFour\" data-bs-parent=\"#travelFaqAccordion\"><div class=\"ca-accordion-body\"><p>Yes, for families, corporate teams, and small groups.</p></div></div>\r\n                    </div>\r\n                </div>                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n</main>\r\n\r\n\r\n    <footer class=\"travlink-footer\">\n    <div class=\"container\">\n        <div class=\"travlink-footer__top\">\n            <div class=\"travlink-footer__brand\">\n                <a class=\"travlink-footer__logo\" href=\"/\" aria-label=\"Travlink Global home\">\n                    <span class=\"travlink-footer__logo-mark\" aria-hidden=\"true\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <span>Travlink Global</span>\n                </a>\n                <p class=\"travlink-footer__description\">Connecting people and businesses across borders through trusted travel, trade, and shipping solutions.</p>\n                <div class=\"travlink-footer__socials\" aria-label=\"Social media links\">\n                    <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                    <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                    <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                    <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                </div>\n            </div>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer quick links\">\n                <h2>Quick Links</h2>\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/about/\">About</a></li>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li>