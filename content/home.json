  "headMarkup": "<link rel=\"stylesheet\" href=\"/css/home-hero-premium.css?v=G4u0c06fI-_-LvJwpYDxb5GwcTbaLB1-LGK7o7VOkDs\" />\n<link rel=\"stylesheet\" href=\"/css/bootstrap.min.css\">\n<link rel=\"stylesheet\" href=\"/css/all.css\">\n<link rel=\"stylesheet\" href=\"/css/magnific-popup.css\">\n<link rel=\"stylesheet\" href=\"/css/slick.css\">\n<link rel=\"stylesheet\" href=\"/css/slick-theme.css\">\n<link rel=\"stylesheet\" href=\"/css/nice-select.css\">\n<link rel=\"stylesheet\" href=\"/css/typography.css\">\n<link rel=\"stylesheet\" href=\"/css/aos.css\">\n<link rel=\"stylesheet\" href=\"/css/style.css\">\n<link rel=\"stylesheet\" href=\"/css/responsive.css\">\n<link rel=\"stylesheet\" href=\"/css/editorial.css\">\n<link rel=\"stylesheet\" href=\"/css/footer-premium.css\">\n<link rel=\"stylesheet\" href=\"/css/whatsapp-float.css\">\n<link rel=\"stylesheet\" href=\"/css/scroll-motion.css\">\n<link rel=\"stylesheet\" href=\"/css/mobile-responsive.css\">\n<style>\n        .travlink-home .header-area-3 {\n            position: absolute;\n            top: 24px;\n            left: 0;\n            right: 0;\n            z-index: 50;\n            background: transparent;\n        }\n\n        .travlink-home .header-area-3 .header-3 {\n            max-width: 1280px;\n            margin: 0 auto;\n            padding: 14px 24px;\n            background: rgba(255, 255, 255, 0.82);\n            border: 1px solid rgba(255, 255, 255, 0.45);\n            border-radius: 999px;\n            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);\n            backdrop-filter: blur(18px);\n            -webkit-backdrop-filter: blur(18px);\n        }\n\n        .travlink-home .header-area-3.stiky.scroll-header .header-3 {\n            background: rgba(255, 255, 255, 0.9);\n            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);\n        }\n\n        .travlink-home .travlink-hero {\n            position: relative;\n            min-height: 100vh;\n            display: flex;\n            align-items: center;\n            overflow: hidden;\n            background-image: url('/img/slider/heronew.png');\n            background-size: cover;\n            background-position: center;\n            background-repeat: no-repeat;\n            isolation: isolate;\n            padding: 140px 0 100px;\n        }\n\n        .travlink-home .travlink-hero::before {\n            content: \"\";\n            position: absolute;\n            inset: 0;\n            background:\n                linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.46) 100%),\n                linear-gradient(180deg, rgba(0, 0, 0, 0.12) 0%, rgba(0, 0, 0, 0.34) 100%);\n            z-index: 0;\n        }\n\n        .travlink-home .travlink-hero__inner {\n            position: relative;\n            z-index: 1;\n            width: 100%;\n        }\n\n        .travlink-home .travlink-hero__content {\n            max-width: 920px;\n            margin: 0 auto;\n            color: #fff;\n            text-align: center;\n            animation: travlinkFadeUp 900ms ease-out both;\n            padding-top: 80px;\n        }\n\n        .travlink-home .travlink-hero__badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n\n    padding: 7px 16px;\n    margin-bottom: 24px;\n\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.88);\n    border: 1px solid rgba(255, 255, 255, 0.75);\n\n    color: #1f2937;\n    font-size: 11px;\n    font-weight: 600;\n    line-height: 1;\n\n    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n}\n\n.travlink-home .travlink-hero__badge-dot {\n    width: 5px;\n    height: 5px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: #3b9eea;\n    box-shadow: 0 0 0 3px rgba(59, 158, 234, 0.12);\n}\n\n        .travlink-home .travlink-hero__title {\n            color: #fff;\n            font-size: clamp(3rem, 6vw, 4.5rem);\n            line-height: 1.05;\n            font-weight: 600;\n            letter-spacing: -0.03em;\n            margin: 0 auto;\n            text-wrap: balance;\n            text-shadow: 0 12px 36px rgba(0, 0, 0, 0.3);\n        }\n        .travlink-home .travlink-hero__title .title-white{\n    color:#ffffff;\n}\n\n.travlink-home .travlink-hero__title .title-blue{\n    color:#4DA3FF; /* Change to your preferred blue */\n}\n\n\n        .travlink-home .travlink-hero__copy {\n            max-width: 760px;\n            margin: 22px auto 0;\n            color: rgba(255, 255, 255, 0.92);\n            font-size: clamp(1.02rem, 1.6vw, 1.2rem);\n            line-height: 1.8;\n            text-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);\n        }\n\n        .travlink-home .travlink-hero__actions {\n            display: flex;\n            justify-content: center;\n            gap: 16px;\n            flex-wrap: wrap;\n            margin-top: 34px;\n        }\n\n        .travlink-home .ca-btn-primary-3 {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n\n    padding: 10px 30px;\n    min-height: 56px;\n\n    border-radius: 999px;\n    border: none;\n\n    background: linear-gradient(135deg, rgba(45,127,249,.35),);\n    color: #fff !important;\n\n    font-size: 15px;\n    font-weight: 600;\n\n    box-shadow: 0 15px 35px rgba(45,127,249,.35);\n    transition: all .35s ease;\n}\n\n.travlink-home .ca-btn-primary-3:hover{\n    transform: translateY(-3px);\n    box-shadow: 0 22px 45px rgba(45,127,249,.45);\n    color:#fff;\n}\n\n        .travlink-home .travlink-hero__actions .travlink-secondary {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            padding: 7px 28px;\n            min-height: 54px;\n            border-radius: 999px;\n            border: 1px solid rgba(255, 255, 255, 0.55);\n            color: #fff;\n            background: rgba(255, 255, 255, 0.08);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px);\n            transition: 220ms ease;\n        }\n\n        .travlink-home .travlink-hero__actions .travlink-secondary:hover {\n            background: rgba(255, 255, 255, 0.16);\n            transform: translateY(-1px);\n        }\n\n        .travlink-home .travlink-hero__actions .ca-btn-primary-3 span,\n        .travlink-home .travlink-hero__actions .travlink-secondary span {\n            margin-left: 10px;\n        }\n\n        .travlink-home .travlink-blue-shade {\n            background:\n                radial-gradient(circle at 8% 24%, rgba(63, 169, 225, 0.20) 0, rgba(63, 169, 225, 0) 40%),\n                radial-gradient(circle at 92% 72%, rgba(88, 181, 229, 0.14) 0, rgba(88, 181, 229, 0) 42%),\n                linear-gradient(180deg, #ffffff 0%, #f4faff 11%, #e8f5fc 48%, #f3faff 88%, #ffffff 100%);\n        }\n\n        .travlink-home .travlink-process {\n            border-top: 0;\n            border-bottom: 0;\n            background: linear-gradient(180deg, #ffffff 0%, #f4eee7 14%, #ede5db 48%, #f5efe9 86%, #ffffff 100%);\n        }\n\n        .travlink-home main > section {\n            background-clip: padding-box;\n        }\n\n        .travlink-home .travlink-white-section {\n            background: #ffffff;\n        }\n\n        @keyframes travlinkFadeUp {\n            from {\n                opacity: 0;\n                transform: translateY(28px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        @media (max-width: 991px) {\n            .travlink-home .header-area-3 {\n                position: absolute;\n                top: 16px;\n            }\n\n            .travlink-home .header-area-3 .header-3 {\n                border-radius: 28px;\n                padding: 12px 18px;\n            }\n\n            .travlink-home .travlink-hero {\n                min-height: 92vh;\n                padding: 120px 0 80px;\n            }\n\n            .travlink-home .travlink-hero__content {\n                max-width: 920px;\n            }\n        }\n\n        @media (max-width: 767px) {\n            .travlink-home .travlink-hero {\n                min-height: 90vh;\n                padding: 110px 0 64px;\n            }\n\n            .travlink-home .travlink-hero__title {\n                font-size: clamp(2.2rem, 11vw, 3rem);\n            }\n\n\n            .travlink-home .travlink-hero__copy {\n                margin-top: 18px;\n            }\n\n            .travlink-home .travlink-hero__actions {\n                gap: 12px;\n            }\n        }\n    </style>",
  "bodyMarkup": "\r\n\r\n    \r\n     <!-- Header Area Start-->\r\n<header class=\"header-area-3 stiky\">\r\n    <div class=\"container fluid-header-3\">\r\n        <div class=\"row align-items-center\">\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-logo -->\r\n                <div class=\"ca-logo\">\r\n                    <H3>LOGO---</h3>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-6 col-lg-7 d-none d-lg-block\">\r\n                <!-- ca-main-menu -->\r\n                <div class=\"ca-main-menu-3\">\r\n                    <nav class=\"ca-mobile-menu-active-3\">\r\n                        <ul>\r\n                            <li>\r\n                                <a href=\"/\">Home <span></i></span></a>\r\n                            </li>\r\n                            <li><a href=/about/>About Us</a></li>\r\n                            <li>\r\n                                <a href=\"#\">Services<span><i class=\"fa-solid fa-angle-down\"></i></span></a>\r\n                                <ul class=\"sub-menu\">\r\n                                    <li><a href=/travel/>Travel</a></li>\r\n                                    <li><a href=/trade/>Trade</a></li>\r\n                                    <li><a href=/shipping/>Shipping</a></li>\r\n                                </ul>\r\n                            </li>\r\n                            \r\n                            <li>\r\n<a href=\"/faq/\">FAQ<san></span></a>                                \r\n                            </li>\r\n                            <li>                             <a href=\"/contact/\">Contact Us<san></span></a>\r\n</li>\r\n                        </ul>\r\n                    </nav>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-xl-3 col-lg col-md-6 col-6\">\r\n                <!-- ca-btn -->\r\n                <div class=\"ca-header-action-item d-lg-none text-end\">\r\n                    <button type=\"button\" class=\"ca-offcanvas-toogle\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"16\" viewBox=\"0 0 30 16\">\r\n                            <rect x=\"10\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"5\" y=\"7\" width=\"25\" height=\"2\" fill=\"currentColor\"></rect>\r\n                            <rect x=\"10\" y=\"14\" width=\"20\" height=\"2\" fill=\"currentColor\"></rect>\r\n                        </svg>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</header>\r\n<!-- Header area end -->\r\n<!-- offcanvas start -->\r\n<div class=\"ca-offcanvas w-bg\">\r\n    <div class=\"ca-offcanvas-wrapper\">\r\n        <div class=\"ca-offcanvas-header d-flex justify-content-between align-items-center mb-40\">\r\n            <div class=\"ca-offcanvas-logo\">\r\n            </div>\r\n            <div class=\"ca-offcanvas-close\">\r\n                <button class=\"ca-offcanvas-close-toggle\"><i class=\"fal fa-times\"></i></button>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-menu-3 mb-40\">\r\n            <nav>\r\n            </nav>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact mb-40\">\r\n            <a href=\"#\" class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\">Get A Quote <span><i class=\"fa-solid fa-angle-right\"></i></span></a>\r\n        </div>\r\n        <div class=\"ca-offcanvas-contact-info mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Contact Info</h3>\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-location-dot\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p>\r\n                        <a href=\"#\">\r\n                            55 Street, 2nd block, 3rd Floor\r\n                            Melbourne, Australia\r\n                        </a>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-phone\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"tel:+0221234568806\">+022 (123) 456 88 06</a></p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-envelope\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"mailto:infocargon@gmail.com\">infoTravlink@gmail.com</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-social mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Follow Us</h3>\r\n            <div class=\"ca-footer-social ca-footer-social-3\">\r\n                <ul>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a></li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"ca-offcanvas-overlay\"></div>\r\n<!-- offcanvas end -->\r\n    \n\n\n\n\n<main>\n    <!-- hero start -->\n    <section class=\"travlink-hero\">\n        <div class=\"travlink-hero__media\" aria-hidden=\"true\"></div>\n        <div class=\"travlink-hero__inner\">\n            <div class=\"container\">\n                <div class=\"row justify-content-center\">\n                    <div class=\"col-xl-10 col-lg-11\">\n                        <div class=\"travlink-hero__content\">\n                            <div class=\"travlink-hero__badge\">\n    <span class=\"travlink-hero__badge-dot\"></span>\n    Travlink Global\n</div>\n                           <h1 class=\"travlink-hero__title\">\n    <span class=\"title-blue\">Travel &bull; Trade &bull; Connect</span>\n</h1>\n                            <p class=\"travlink-hero__copy\">From visas to vessels, we help people and businesses move across borders &mdash; with travel, trade, and shipping handled under one roof. Explore what we do, and where it can take you.</p>\n                            <div class=\"travlink-hero__actions\">\n                                <a href=\"#travlink-services\" class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\">\n                                    Explore Services\n                                    <span><i class=\"fa-solid fa-angle-right\"></i></span>\n                                </a>\n                                <a href=\"/contact/\" class=\"travlink-secondary\">\n                                    Contact Us\n                                    <span><i class=\"fa-solid fa-angle-right\"></i></span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"travlink-hero__scroll\" aria-hidden=\"true\"><span class=\"travlink-hero__mouse\"><span></span></span></div>\n    </section>\n    <!-- hero end -->\n    \n    <!-- service section start -->\n    <section id=\"travlink-services\" class=\"ca-service-3 travlink-service-section travlink-blue-shade pt-30 pb-70\">\n        <div class=\"container\">\n            <div class=\"ca-portfolio-content-3 ca-sec-content-3 travlink-service-intro text-center mb-60 aos-init aos-animate\" data-aos=\"fade-up\" data-aos-duration=\"800\">\n                \n                <span class=\"travlink-service-intro__eyebrow\">Our Services</span>\n                <h2 class=\"travlink-service-intro__title\">One world. <em>Three ways forward.</em></h2>\n            </div>\n        </div>\n        <div class=\"container\">\n            <div class=\"row g-4 ca-service-3-cards\">\n                <div class=\"col-lg-4 col-md-6\" >\n                    <article class=\"travlink-service-card\" tabindex=\"0\" aria-expanded=\"false\">\n                        <img class=\"travlink-service-card__image\" src=\"/img/service/SRV.jpeg\" alt=\"Luxury international travel experience\">\n                        <div class=\"travlink-service-card__content\">\n                            <h2 class=\"travlink-service-card__title\">Travel</h2>\n                            <p class=\"travlink-service-card__description\">Visas, holidays, and business trips &mdash; planned around you, not a template.</p>\n                            <a class=\"travlink-service-card__cta\" href=\"/travel/\">Explore<span aria-hidden=\"true\">&rarr;</span></a>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"col-lg-4 col-md-6\">\n                    <article class=\"travlink-service-card\" tabindex=\"0\" aria-expanded=\"false\">\n                        <img class=\"travlink-service-card__image\" src=\"/img/service/SRV3.jpeg\" alt=\"International trade and sourcing\">\n                        <div class=\"travlink-service-card__content\">\n                            <h2 class=\"travlink-service-card__title\">Trade</h2>\n                            <p class=\"travlink-service-card__description\">Sourcing and supplier connections across China, Vietnam, and beyond.</p>\n                            <a class=\"travlink-service-card__cta\" href=\"/trade/\">Explore <span aria-hidden=\"true\">&rarr;</span></a>\n                        </div>\n                    </article>\n                </div>\n                <div class=\"col-lg-4 col-md-6\">\n                    <article class=\"travlink-service-card\" tabindex=\"0\" aria-expanded=\"false\">\n                        <img class=\"travlink-service-card__image\" src=\"/img/service/SRV2.jpeg\" alt=\"Global cargo shipping operation\">\n                        <div class=\"travlink-service-card__content\">\n                            <h2 class=\"travlink-service-card__title\">Shipping</h2>\n                            <p class=\"travlink-service-card__description\">Freight, customs, and delivery &mdash; handled door to door.</p>\n                            <a class=\"travlink-service-card__cta\" href=\"/shipping/\">Explore <span aria-hidden=\"true\">&rarr;</span></a>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- service section end -->\n\n    <!-- why choose us section start -->\n    <!-- why choose us section end -->\n\n     <!-- process section start -->\n    <section class=\"travlink-process\" aria-labelledby=\"travlink-process-title\">\n        <div class=\"container\">\n            <div class=\"travlink-process__header ca-sec-content-3 text-center\" data-aos=\"fade-up\" data-aos-duration=\"700\">\n                <h5 class=\"ca-section-subtitle p-relative\" \">Our Process</h5>\n                <h5 class=\"ca-section-title fnw-600\" id=\"travlink-process-title\">A Simple Process, <em>Built Around You</em></h5>\n            </div> \n\n            <div class=\"travlink-process__grid\">\n                <article class=\"travlink-process__step\" data-aos=\"fade-up\" data-aos-delay=\"0\" data-aos-duration=\"650\">\n                    <span class=\"travlink-process__number\">01</span>\n                    <h3>Contact Us</h3>\n                    <p>Reach out with what you need&mdash;travel, trade, or shipping.</p>\n                </article>\n\n                <article class=\"travlink-process__step\" data-aos=\"fade-up\" data-aos-delay=\"100\" data-aos-duration=\"650\">\n                    <span class=\"travlink-process__number\">02</span>\n                    <h3>Tell Us Your Requirement</h3>\n                    <p>Share the details. We&rsquo;ll ask the right questions.</p>\n                </article>\n\n                <article class=\"travlink-process__step\" data-aos=\"fade-up\" data-aos-delay=\"200\" data-aos-duration=\"650\">\n                    <span class=\"travlink-process__number\">03</span>\n                    <h3>We Plan the Best Solution</h3>\n                    <p>A plan built around your requirement, not a fixed package.</p>\n                </article>\n\n                <article class=\"travlink-process__step\" data-aos=\"fade-up\" data-aos-delay=\"300\" data-aos-duration=\"650\">\n                    <span class=\"travlink-process__number\">04</span>\n                    <h3>We Deliver the Service</h3>\n                    <p>From first enquiry to final delivery, we stay involved.</p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- process section end -->\n\n     <!-- about section start -->\n    <section class=\"ca-about-3 travlink-about-editorial\" aria-labelledby=\"travlink-about-title\">\n        <div class=\"container\">\n            <div class=\"travlink-about-editorial__layout\">\n                <div class=\"travlink-about-editorial__collage\" aria-label=\"Travlink Global across Asia and international markets\">\n                    <div class=\"travlink-about-editorial__column travlink-about-editorial__column--left\">\n                        <figure class=\"travlink-about-editorial__image travlink-about-editorial__image--large\">\n                            <img src=\"/img/about/abt1.png\" alt=\"International flight viewed above the clouds\">\n                            <figcaption>Visa Assistance</figcaption>\n                        </figure>\n                        <figure class=\"travlink-about-editorial__image travlink-about-editorial__image--small\">\n                            <img src=\"/img/service/trade.jpg\" alt=\"International business partners completing a trade agreement\">\n                            <figcaption>Sourcing</figcaption>\n                        </figure>\n                    </div>\n                    <div class=\"travlink-about-editorial__column travlink-about-editorial__column--right\">\n                        <figure class=\"travlink-about-editorial__image travlink-about-editorial__image--small\">\n                            <img src=\"/img/faq/faq1.jpeg\" alt=\"Container ship sailing at sunset\">\n                            <figcaption>Ocean Shipping</figcaption>\n                        </figure>\n                        <figure class=\"travlink-about-editorial__image travlink-about-editorial__image--large\">\n                            <img src=\"/img/service/tt.jpg\" alt=\"Modern warehouse and global supply chain operation\">\n                            <figcaption>Travel packages</figcaption>\n                        </figure>\n                    </div>\n                </div>\n                <div class=\"travlink-about-editorial__content\">\n                    <span class=\"travlink-about-editorial__eyebrow\">About Us</span>\n                    <h2 id=\"travlink-about-title\">Built for journeys, trade, <em>and movement across borders.</em></h2>\n                    <div class=\"travlink-about-editorial__copy\">\n                        <p>Travlink Global is a travel, trade, and shipping company built on founder-led experience &mdash; in visa facilitation, sourcing, and travel planning. We bring that experience together under one platform, built for people and businesses who want things handled properly, without the noise.</p>\n                        <p>We focus on creating seamless global experiences while staying professional, transparent, and genuinely useful to the people we work with.</p>\n                    </div>\n                    <div class=\"ca-about-3-btn\">\n                        <a href=/about/ class=\"travlink-about-editorial__button\">About Travlink Global <span><i class=\"fa-solid fa-angle-right\"></i></span></a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>    <!-- about section end -->\n    <!-- portfolio section start -->\n    <!-- portfolio section end -->\n    <!-- video area start -->\n  \n    <!-- contact-section start -->\n    <section class=\"contact-3-area travlink-blue-shade pt-100 pb-70\">\n        <div class=\"container\">\n            <div class=\"ca-blog-content-3 ca-sec-content-3 text-center mb-60 aos-init aos-animate\" data-aos=\"zoom-out-down\" data-aos-duration=\"1000\">\n                <h5 class=\"ca-section-subtitle subtitle-bg-6 p-relative theme-color-3 br-50\">Contact Us</h5>\n                <h2 class=\"ca-section-title theme-black-3 fnw-600 pt-16 ca-text-cap\">Tell us what you need &mdash; <em>we'll take it from there.</em></h2>\n            </div>\n            <div class=\"row align-items-center\">\n                <div class=\"col-xl-6 mb-30\">\n                    <div class=\"ca-contact-from w-bg ca-contact-from-3 aos-init aos-animate\" data-aos=\"fade-right\" data-aos-duration=\"1200\">\n                        <div class=\"ca-contact-content-3\">\n                            <h4 class=\"ca-contact-title-2 theme-black-2 fnw-600\">Send Us A Message</h4>\n                            <p class=\"pt-16 pb-24\">As a fellow small business owner, we know the fulfillment that an a best to comes from running & own business contact our service to Travlink.</p>\n                        </div>\n                        <form action=\"#\">\n                            <div class=\"row\">\n                                <div class=\"col-md-6 mb-20\">\n                                    <input type=\"text\" placeholder=\"First Name\">\n                                </div>\n                                <div class=\"col-md-6 mb-20\">\n                                    <input type=\"text\" placeholder=\"Last Name\">\n                                </div>\n                                <div class=\"col-md-6 mb-20\">\n                                    <input type=\"tel\" placeholder=\"Phone Number\">\n                                </div>\n                                <div class=\"col-md-6 mb-20\">\n                                    <input type=\"email\" placeholder=\"Email Address\">\n                                </div>\n                                <div class=\"col-md-12 mb-20\">\n                                    <select class=\"nice-select wide ca-select\">\n                                        <option value=\"1\">Travel</option>\n                                        <option value=\"2\">Trade</option>\n                                        <option value=\"3\">Logistics</option>\n                                    </select>\n                                </div>\n                                <div class=\"col-md-12 mb-20\">\n                                    <textarea name=\"message\" id=\"message\" placeholder=\"Message\"></textarea>\n                                </div>\n                                <div class=\"submit-btn\">\n                                    <button class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\" type=\"submit\" value=\"submit\"> Send Message<span><i class=\"fa-solid fa-angle-right\"></i></span></button>\n                                </div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n                <div class=\"col-xl-6 mb-30\">\n                    <div class=\"ca-form-loca-3 ml-50 aos-init aos-animate\" data-aos=\"fade-left\" data-aos-duration=\"1400\">\n                        <!-- single box item -->\n                        <div class=\"ca-location-3 mb-20\">\n                            <div class=\"ca-location-icbox\">\n                                <div class=\"ca-location-icbox-img\">\n                                    <span><img src=\"/img/icon/ca-location3.1.svg\" alt=\"\"></span>\n                                </div>\n                                <div class=\"ca-location-icbox-text\">\n                                    <h4 class=\"ca-title fnw-600 theme-black-3 pb-12\">Contact Us</h4>\n                                    <p>198 West 21th Street,New York NY City 1010 <br> travlink@mail.com</p>\n                                </div>\n                            </div>\n                        </div>\n                        <!-- single box item -->\n                        <div class=\"ca-location-3 mb-20\">\n                            <a class=\"ca-location-icbox travlink-whatsapp-card\"\n                               href=\"https://wa.me/\"\n                               target=\"_blank\"\n                               rel=\"noopener noreferrer\"\n                               aria-label=\"Chat with Travlink Global on WhatsApp\">\n                                <div class=\"ca-location-icbox-img\">\n                                    <span><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i></span>\n                                </div>\n                                <div class=\"ca-location-icbox-text\">\n                                    <h4 class=\"ca-title fnw-600 theme-black-3 pb-12\">Chat on WhatsApp</h4>\n                                    <span class=\"travlink-whatsapp-card__copy\">Message us directly</span>\n                                </div>\n                            </a>\n                        </div>\n                        <!-- single box item -->\n                        <div class=\"ca-location-3 mb-20\">\n                            <div class=\"ca-location-icbox\">\n                                <div class=\"ca-location-icbox-img\">\n                                    <span><img src=\"/img/icon/ca-location3.3.svg\" alt=\"\"></span>\n                                </div>\n                                <div class=\"ca-location-icbox-text\">\n                                    <h4 class=\"ca-title fnw-600 theme-black-3 pb-12\">Send Email</h4>\n                                    <a href=\"mailto:infotransportlogistics@gmail.com\">infotravlinkglobal@gmail.com</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- contact-section end -->\n    <!-- blog section end -->\n\n</main>\n\n\r\n    <footer class=\"travlink-footer\">\n    <div class=\"container\">\n        <div class=\"travlink-footer__top\">\n            <div class=\"travlink-footer__brand\">\n                <a class=\"travlink-footer__logo\" href=\"/\" aria-label=\"Travlink Global home\">\n                    <span class=\"travlink-footer__logo-mark\" aria-hidden=\"true\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <span>Travlink Global</span>\n                </a>\n                <p class=\"travlink-footer__description\">Connecting people and businesses across borders through trusted travel, trade, and shipping solutions.</p>\n                <div class=\"travlink-footer__socials\" aria-label=\"Social media links\">\n                    <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                    <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                    <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                    <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                </div>\n            </div>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer quick links\">\n                <h2>Quick Links</h2>\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/about/\">About</a></li>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                    <li><a href=\"/contact/\">Contact</a></li>\n                </ul>\n            </nav>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer services\">\n                <h2>Services</h2>\n                <ul>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                </ul>\n            </nav>\n\n            <div class=\"travlink-footer__column travlink-footer__contact\">\n                <h2>Contact &amp; Legal</h2>\n                <ul>\n                    <li><a href=\"https://wa.me/\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>WhatsApp</a></li>\n                    <li><a href=\"mailto:infotravlinkglobal@gmail.com\"><i class=\"fa-regular fa-envelope\" aria-hidden=\"true\"></i>Travlinkglobal@gmail.com </a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"travlink-footer__bottom\">\n            <p class=\"travlink-footer__copyright\">&copy; 2026 Travlink Global. All rights reserved.</p>\n            <nav class=\"travlink-footer__legal\" aria-label=\"Legal links\">\n                <a href=\"#\">Privacy Policy</a>\n                <a href=\"#\">Terms &amp; Conditions</a>\n            </nav>\n        </div>\n    </div>\n</footer>\n\n\r\n    <button id=\"topBtn3\"><i class=\"fa-solid fa-arrow-up\"></i></button>\r\n    <a class=\"travlink-whatsapp-float\"\n   href=\"https://wa.me/\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\"\n   aria-label=\"Contact Travlink Global on WhatsApp\">\n    <i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>\n</a>\r\n\r\n    <script src=\"/js/jquery-3.7.1.min.js\"></script>\r\n<script src=\"/js/bootstrap.bundle.min.js\"></script>\r\n<script src=\"/js/jquery.magnific-popup.min.js\"></script>\r\n<script src=\"/js/jquery.counterup.min.js\"></script>\r\n<script src=\"/js/slick.min.js\"></script>\r\n<script src=\"/js/jquery.nice-select.js\"></script>\r\n<script src=\"/js/waypoints.min.js\"></script>\r\n<script src=\"/js/aos.js\"></script>\r\n<script src=\"/js/main.js\"></script>\r\n<script src=\"/js/scroll-motion.js\"></script>\r\n<script src=\"/js/mobile-navigation.js\"></script>\r\n\r\n\r\n    \n    <script>\n        document.addEventListener('DOMContentLoaded', function () {\n            const cards = Array.from(document.querySelectorAll('.travlink-service-card'));\n            const slider = document.querySelector('.ca-service-3-cards');\n            const usesTap = window.matchMedia('(hover: none)').matches;\n            const usesDesktopCards = window.matchMedia('(min-width: 992px)');\n            const usesMobileSlider = window.matchMedia('(max-width: 767px)');\n            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n            let currentIndex = 0;\n            let autoScrollTimer;\n            let resumeTimer;\n            let scrollFrame;\n            let autoScrollReleaseTimer;\n            let isUserInteracting = false;\n            let isAutoScrolling = false;\n            let isServiceSectionVisible = false;\n            let hasEnteredServiceSection = false;\n\n            function setCardState(card, active) {\n                card.classList.toggle('is-active', active);\n                card.setAttribute('aria-expanded', active ? 'true' : 'false');\n            }\n\n            function setActiveCard(index) {\n                cards.forEach(function (card, cardIndex) {\n                    setCardState(card, cardIndex === index);\n                });\n                currentIndex = index;\n            }\n\n            function stopAutoScroll() {\n                window.clearInterval(autoScrollTimer);\n                autoScrollTimer = null;\n            }\n\n            function scrollToCard(index) {\n                if (!slider || !cards[index]) return;\n\n                const cardColumn = cards[index].parentElement;\n                const sliderRect = slider.getBoundingClientRect();\n                const cardRect = cardColumn.getBoundingClientRect();\n                const targetLeft = slider.scrollLeft + (cardRect.left - sliderRect.left) - ((slider.clientWidth - cardRect.width) / 2);\n\n                isAutoScrolling = true;\n                window.clearTimeout(autoScrollReleaseTimer);\n                slider.scrollTo({ left: targetLeft, behavior: 'smooth' });\n                autoScrollReleaseTimer = window.setTimeout(function () {\n                    isAutoScrolling = false;\n                }, 1200);\n            }\n\n            function startAutoScroll() {\n                stopAutoScroll();\n                if (!usesMobileSlider.matches || reducedMotion.matches || !isServiceSectionVisible || cards.length < 2) return;\n\n                autoScrollTimer = window.setInterval(function () {\n                    if (isUserInteracting) return;\n                    scrollToCard((currentIndex + 1) % cards.length);\n                }, 4000);\n            }\n\n            function resumeAfterInactivity() {\n                if (!usesMobileSlider.matches) return;\n\n                window.clearTimeout(resumeTimer);\n                resumeTimer = window.setTimeout(function () {\n                    isUserInteracting = false;\n                    startAutoScroll();\n                }, 4000);\n            }\n\n            function holdAutoScroll() {\n                if (!usesMobileSlider.matches) return;\n                isUserInteracting = true;\n                stopAutoScroll();\n                window.clearTimeout(resumeTimer);\n            }\n\n            function pauseAfterManualScroll() {\n                holdAutoScroll();\n                resumeAfterInactivity();\n            }\n\n            function updateActiveCard() {\n                scrollFrame = null;\n                if (!slider || !usesMobileSlider.matches) return;\n\n                const sliderRect = slider.getBoundingClientRect();\n                const sliderCenter = sliderRect.left + (slider.clientWidth / 2);\n                let closestIndex = 0;\n                let closestDistance = Infinity;\n\n                cards.forEach(function (card, index) {\n                    const rect = card.getBoundingClientRect();\n                    const distance = Math.abs(sliderCenter - (rect.left + rect.width / 2));\n                    if (distance < closestDistance) {\n                        closestDistance = distance;\n                        closestIndex = index;\n                    }\n                });\n\n                setActiveCard(closestIndex);\n            }\n\n            function requestActiveCardUpdate() {\n                if (scrollFrame) return;\n                scrollFrame = window.requestAnimationFrame(updateActiveCard);\n            }\n\n            function configureMobileSlider() {\n                stopAutoScroll();\n                window.clearTimeout(resumeTimer);\n                window.clearTimeout(autoScrollReleaseTimer);\n                isUserInteracting = false;\n                isAutoScrolling = false;\n\n                if (!usesMobileSlider.matches) {\n                    cards.forEach(function (card) { setCardState(card, false); });\n                    return;\n                }\n\n                if (isServiceSectionVisible) {\n                    if (!hasEnteredServiceSection) {\n                        setActiveCard(0);\n                        hasEnteredServiceSection = true;\n                    } else {\n                        requestActiveCardUpdate();\n                    }\n                    startAutoScroll();\n                }\n            }\n\n            cards.forEach(function (card) {\n                card.addEventListener('click', function (event) {\n                    if ((usesDesktopCards.matches || usesMobileSlider.matches) && !event.target.closest('a')) {\n                        const serviceLink = card.querySelector('.travlink-service-card__cta');\n                        if (serviceLink) window.location.assign(serviceLink.href);\n                        return;\n                    }\n\n                    if (usesMobileSlider.matches) return;\n                    if (!usesTap || event.target.closest('a')) return;\n\n                    const shouldOpen = !card.classList.contains('is-active');\n                    cards.forEach(function (item) { setCardState(item, false); });\n                    setCardState(card, shouldOpen);\n                });\n\n                card.addEventListener('keydown', function (event) {\n                    if (event.key !== 'Enter' && event.key !== ' ') return;\n                    if (event.target.closest('a')) return;\n\n                    event.preventDefault();\n                    if (usesDesktopCards.matches || usesMobileSlider.matches) {\n                        const serviceLink = card.querySelector('.travlink-service-card__cta');\n                        if (serviceLink) window.location.assign(serviceLink.href);\n                        return;\n                    }\n\n                    if (usesMobileSlider.matches) return;\n                    const shouldOpen = !card.classList.contains('is-active');\n                    cards.forEach(function (item) { setCardState(item, false); });\n                    setCardState(card, shouldOpen);\n                });\n            });\n\n            document.addEventListener('click', function (event) {\n                if (usesMobileSlider.matches || !usesTap || event.target.closest('.travlink-service-card')) return;\n                cards.forEach(function (card) { setCardState(card, false); });\n            });\n\n            if (slider && cards.length) {\n                slider.addEventListener('scroll', function () {\n                    if (!isAutoScrolling) pauseAfterManualScroll();\n                    requestActiveCardUpdate();\n                }, { passive: true });\n                slider.addEventListener('touchstart', holdAutoScroll, { passive: true });\n                slider.addEventListener('touchend', resumeAfterInactivity, { passive: true });\n                slider.addEventListener('touchcancel', resumeAfterInactivity, { passive: true });\n                slider.addEventListener('pointerdown', holdAutoScroll, { passive: true });\n                slider.addEventListener('pointerup', resumeAfterInactivity, { passive: true });\n                slider.addEventListener('pointercancel', resumeAfterInactivity, { passive: true });\n                slider.addEventListener('wheel', pauseAfterManualScroll, { passive: true });\n\n                const serviceObserver = new IntersectionObserver(function (entries) {\n                    const entry = entries[0];\n                    isServiceSectionVisible = entry.isIntersecting && entry.intersectionRatio >= .15;\n\n                    if (!isServiceSectionVisible) {\n                        stopAutoScroll();\n                        return;\n                    }\n\n                    if (usesMobileSlider.matches) {\n                        if (!hasEnteredServiceSection) {\n                            setActiveCard(0);\n                            hasEnteredServiceSection = true;\n                        } else {\n                            requestActiveCardUpdate();\n                        }\n                        startAutoScroll();\n                    }\n                }, { threshold: [0, .15, .35, .6] });\n\n                serviceObserver.observe(slider);\n                if (usesMobileSlider.addEventListener) {\n                    usesMobileSlider.addEventListener('change', configureMobileSlider);\n                    reducedMotion.addEventListener('change', configureMobileSlider);\n                } else {\n                    usesMobileSlider.addListener(configureMobileSlider);\n                    reducedMotion.addListener(configureMobileSlider);\n                }\n                configureMobileSlider();\n            }\n        });\n    </script>\n\r\n\r\n"
}
