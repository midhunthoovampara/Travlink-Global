ca-sm-single-item-4-content\">\r\n                    <p>\r\n                        <a href=\"#\">\r\n                            55 Street, 2nd block, 3rd Floor\r\n                            Melbourne, Australia\r\n                        </a>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-phone\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"tel:+0221234568806\">+022 (123) 456 88 06</a></p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-envelope\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"mailto:infocargon@gmail.com\">infoTravlink@gmail.com</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-social mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Follow Us</h3>\r\n            <div class=\"ca-footer-social ca-footer-social-3\">\r\n                <ul>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a></li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"ca-offcanvas-overlay\"></div>\r\n<!-- offcanvas end -->\r\n    \n\n<main class=\"travlink-shipping-page\">\n    <section class=\"travlink-shipping-hero\" aria-labelledby=\"shipping-hero-title\">\n        <div class=\"travlink-shipping-hero__content container\">\n            <span class=\"travlink-shipping-hero__label\">Shipping</span>\n            <h1 id=\"shipping-hero-title\">Getting your goods from there to here <span>&mdash;</span><br>without the guesswork.</h1>\n        </div>\n    </section>\n\n    <section class=\"travlink-shipping-services\" aria-labelledby=\"shipping-services-title\">\n        <div class=\"container\">\n            <div class=\"travlink-shipping-services__layout\">\n                <div class=\"travlink-shipping-services__intro\">\n                    <span class=\"travlink-shipping-eyebrow\">Shipping Services</span>\n                    <h2>Every shipment, <em>coordinated with clarity.</em></h2>\n                    <img src=\"/img/service/service2.jpg.jpeg\" alt=\"International cargo and logistics coordination\">\n                </div>\n                <div class=\"travlink-shipping-services__list\">\n                    <article><i class=\"fa-solid fa-plane-up\" aria-hidden=\"true\"></i><h3>Air Freight</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-ship\" aria-hidden=\"true\"></i><h3>Sea Freight</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-file-circle-check\" aria-hidden=\"true\"></i><h3>Customs Clearance</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-boxes-stacked\" aria-hidden=\"true\"></i><h3>Cargo Solutions</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-diagram-project\" aria-hidden=\"true\"></i><h3>Logistics Coordination</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-right-left\" aria-hidden=\"true\"></i><h3>Import &amp; Export Shipping</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                        <article><i class=\"fa-solid fa-truck-fast\" aria-hidden=\"true\"></i><h3>Door-to-Door Shipping</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                    <article><i class=\"fa-solid fa-location-dot\" aria-hidden=\"true\"></i><h3>Shipment Tracking Support</h3><span><i class=\"fa-solid fa-arrow-right\" aria-hidden=\"true\"></i></span></article>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"travlink-shipping-support\" aria-label=\"Shipping consultation and frequently asked questions\">\n        <div class=\"container\">\n            <div class=\"travlink-shipping-support__grid\">\n                <aside class=\"travlink-shipping-contact\">\n                    <span class=\"travlink-shipping-eyebrow\">Contact Us</span>\n                    <h2>Request Shipping <em>Consultation</em></h2>\n                    <form class=\"travlink-shipping-contact__form\" action=\"#\">\n                        <input type=\"text\" placeholder=\"Your Name\" aria-label=\"Your Name\">\n                        <input type=\"email\" placeholder=\"Email Address\" aria-label=\"Email Address\">\n                        <input type=\"tel\" placeholder=\"Phone Number\" aria-label=\"Phone Number\">\n                        <textarea rows=\"5\" placeholder=\"Your Message\" aria-label=\"Your Message\"></textarea>\n                        <button class=\"ca-btn-primary-3 theme-bg-3 text-white br-50\" type=\"submit\">Send Inquiry <span><i class=\"fa-solid fa-angle-right\"></i></span></button>\n                    </form>\n                    <div class=\"travlink-shipping-contact__socials\" aria-label=\"Social media links\">\n                        <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                        <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                        <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                        <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                    </div>\n                </aside>\n                <div class=\"travlink-shipping-faq\">\n                    <div class=\"travlink-shipping-faq__heading\">\n                        <span class=\"travlink-shipping-eyebrow\">Shipping FAQs</span>\n                        <h2>Questions, <em>answered clearly.</em></h2>\n                    </div>\n                    <div class=\"ca-acordion-area travlink-shipping-faq__accordion\">\n                        <div class=\"accordion\" id=\"shippingFaqAccordion\">\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"shippingFaqOne\"><button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#shippingFaqOneContent\" aria-expanded=\"true\" aria-controls=\"shippingFaqOneContent\">What happens if my shipment gets held up in customs?</button></h3>\n                                <div id=\"shippingFaqOneContent\" class=\"accordion-collapse collapse show\" aria-labelledby=\"shippingFaqOne\" data-bs-parent=\"#shippingFaqAccordion\"><div class=\"ca-accordion-body\"><p>We stay involved until it clears. Customs support is part of the service, not a separate call you have to make yourself.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"shippingFaqTwo\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#shippingFaqTwoContent\" aria-expanded=\"false\" aria-controls=\"shippingFaqTwoContent\">Will I know where my shipment is at every stage, or just at the start and end?</button></h3>\n                                <div id=\"shippingFaqTwoContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"shippingFaqTwo\" data-bs-parent=\"#shippingFaqAccordion\"><div class=\"ca-accordion-body\"><p>You'll have tracking support through the journey &mdash; not just a booking confirmation followed by silence.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"shippingFaqThree\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#shippingFaqThreeContent\" aria-expanded=\"false\" aria-controls=\"shippingFaqThreeContent\">Are there hidden charges that show up later?</button></h3>\n                                <div id=\"shippingFaqThreeContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"shippingFaqThree\" data-bs-parent=\"#shippingFaqAccordion\"><div class=\"ca-accordion-body\"><p>We lay out costs as clearly as the shipment allows upfront. If something is genuinely variable, like customs duty, we say so &mdash; we don't pretend it's fixed.</p></div></div>\n                            </div>\n                            <div class=\"ca-accordion-item ca-accordion-item-2 mb-24\">\n                                <h3 class=\"ca-accordion-header\" id=\"shippingFaqFour\"><button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#shippingFaqFourContent\" aria-expanded=\"false\" aria-controls=\"shippingFaqFourContent\">Can you deliver all the way to my door, or just to the port?</button></h3>\n                                <div id=\"shippingFaqFourContent\" class=\"accordion-collapse collapse\" aria-labelledby=\"shippingFaqFour\" data-bs-parent=\"#shippingFaqAccordion\"><div class=\"ca-accordion-body\"><p>Door-to-door is available on many routes &mdash; ask us about yours specifically, since it depends on the destination.</p></div></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</main>\n\r\n    <footer class=\"travlink-footer\">\n    <div class=\"container\">\n        <div class=\"travlink-footer__top\">\n            <div class=\"travlink-footer__brand\">\n                <a class=\"travlink-footer__logo\" href=\"/\" aria-label=\"Travlink Global home\">\n                    <span class=\"travlink-footer__logo-mark\" aria-hidden=\"true\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <span>Travlink Global</span>\n                </a>\n                <p class=\"travlink-footer__description\">Connecting people and businesses across borders through trusted travel, trade, and shipping solutions.</p>\n                <div class=\"travlink-footer__socials\" aria-label=\"Social media links\">\n                    <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                    <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                    <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                    <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                </div>\n            </div>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer quick links\">\n                <h2>Quick Links</h2>\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/about/\">About</a></li>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                    <li><a href=\"/contact/\">Contact</a></li>\n                </ul>\n            </nav>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer services\">\n                <h2>Services</h2>\n                <ul>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                </ul>\n            </nav>\n\n            <div class=\"travlink-footer__column travlink-footer__contact\">\n                <h2>Contact &amp; Legal</h2>\n                <ul>\n                    <li><a href=\"https://wa.me/\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>WhatsApp</a></li>\n                    <li><a href=\"mailto:infotravlinkglobal@gmail.com\"><i class=\"fa-regular fa-envelope\" aria-hidden=\"true\"></i>Travlinkglobal@gmail.com </a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"travlink-footer__bottom\">\n            <p class=\"travlink-footer__copyright\">&copy; 2026 Travlink Global. All rights reserved.</p>\n            <nav class=\"travlink-footer__legal\" aria-label=\"Legal links\">\n                <a href=\"#\">Privacy Policy</a>\n                <a href=\"#\">Terms &amp; Conditions</a>\n            </nav>\n        </div>\n    </div>\n</footer>\n\n\r\n    <button id=\"topBtn3\"><i class=\"fa-solid fa-arrow-up\"></i></button>\r\n    <a class=\"travlink-whatsapp-float\"\n   href=\"https://wa.me/\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\"\n   aria-label=\"Contact Travlink Global on WhatsApp\">\n   