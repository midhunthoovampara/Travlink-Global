ca-sm-single-item-4-content\">\r\n                    <p>\r\n                        <a href=\"#\">\r\n                            55 Street, 2nd block, 3rd Floor\r\n                            Melbourne, Australia\r\n                        </a>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-phone\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"tel:+0221234568806\">+022 (123) 456 88 06</a></p>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- single item -->\r\n            <div class=\"ca-sm-single-item-4 ca-sm-single-item-1 mb-20\">\r\n                <div class=\"icon\">\r\n                    <span>\r\n                        <i class=\"fa-solid fa-envelope\"></i>\r\n                    </span>\r\n                </div>\r\n                <div class=\"ca-sm-single-item-4-content\">\r\n                    <p><a href=\"mailto:infocargon@gmail.com\">infoTravlink@gmail.com</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"ca-offcanvas-social mb-40\">\r\n            <h3 class=\"ca-offcanvas-sm-title\">Follow Us</h3>\r\n            <div class=\"ca-footer-social ca-footer-social-3\">\r\n                <ul>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></li>\r\n                    <li><a href=\"#\"><i class=\"fa-brands fa-x-twitter\"></i></a></li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"ca-offcanvas-overlay\"></div>\r\n<!-- offcanvas end -->\r\n    \r\n\r\n\n\r\n<main>\r\n    <!-- breadcrumb area start -->\r\n    </section>\r\n    <!-- breadcrumb area end -->\r\n\r\n    <div class=\"ca-faq-inner pt-100 pb-70\">\r\n        <div class=\"container\">\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-6 mb-30\">\r\n                    <div class=\"ca-faq-iner-thumb p-relative mr-65\">\r\n                        <img class=\"w-100\" src=\"/img/faq/faq1.jpeg\" alt=\"\">\r\n                        <div class=\"ca-fa-sm-thumb\">\r\n                            <img src=\"/img/faq/faq2.jpeg\" alt=\"\">\r\n                        </div>\r\n\r\n                        <div class=\"ca-iner-review-text ca-faq-iner-review p-absolute theme-bg-3\">\r\n                            <h3 class=\"ca-counter-title fnw-700 pb-16\"><span class=\"counter\">28</span>+</h3>\r\n                            <p>Years Of Experience</p>\r\n                            <div class=\"ca-test-3-rating ca-faq-rating\">\r\n                                <div class=\"ca-ratings-3\">\r\n                                    <span class=\"fa fa-star checked star\"></span>\r\n                                    <span class=\"fa fa-star checked star\"></span>\r\n                                    <span class=\"fa fa-star checked star\"></span>\r\n                                    <span class=\"fa fa-star checked star\"></span>\r\n                                    <span class=\"fa fa-star checked star\"></span>\r\n                                </div>\r\n                                <div class=\"ca-rating-num-3\">\r\n                                    <h4 class=\"ca-rating-title-3\">(5) <span class=\"rat-title\">Rating</span></h4>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-lg-6 mb-30\">\r\n                    <div class=\"ca-about-content-3 ca-sec-content-3 mb-48\">\r\n                        <h5 class=\"ca-section-subtitle subtitle-bg-6 p-relative theme-color-3 br-50\">FAQ'S</h5>\r\n                        <h2 class=\"ca-section-title theme-black-3 fnw-600 pt-16 ca-text-cap\">\n                            Frequently Asked Questions\n                            <em>and Answers</em>\n                        </h2>\r\n                    </div>\r\n                    <div class=\"ca-faq-accordion-one\">\r\n                        <div class=\"accordion\" id=\"accordionExample\">\r\n                            <!-- single item -->\r\n                            <div class=\"ca-iner-one accordion-item\">\r\n                                <h2 class=\"accordion-header\" id=\"heading2\">\r\n                                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\r\n                                        <span><i class=\"fa-solid fa-angle-down\"></i></span> How is Travlink Global different from a regular travel or visa agency?\n                                    </button>\r\n                                </h2>\r\n                                <div id=\"collapse2\" class=\"accordion-collapse collapse\" aria-labelledby=\"heading2\" data-bs-parent=\"#accordionExample\">\r\n                                    <div class=\"accordion-body\">\r\n                                        <p>Most agencies do one thing well. We handle travel, sourcing, and shipping under one roof, with the same point of contact throughout &mdash; so you're not repeating your situation to three different people.</p>\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <!-- single item -->\r\n                            <div class=\"ca-iner-one accordion-item\">\r\n                                <h2 class=\"accordion-header\" id=\"heading1\">\r\n                                    <button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapse1\" aria-expanded=\"true\" aria-controls=\"collapse1\">\r\n                                        <span><i class=\"fa-solid fa-angle-down\"></i></span> Which countries do you currently cover?\n                                    </button>\r\n                                </h2>\r\n                                <div id=\"collapse1\" class=\"accordion-collapse collapse show\" aria-labelledby=\"heading1\" data-bs-parent=\"#accordionExample\">\r\n                                    <div class=\"accordion-body\">\r\n                                        <p>Our strongest experience is GCC visas (Qatar, Kuwait), sourcing from China and Vietnam, and travel across Asia, including Uzbekistan and Kazakhstan. If your destination isn't listed, ask anyway &mdash; our network is wider than the website.</p>\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <!-- single item -->\r\n                            <div class=\"ca-iner-one accordion-item\">\r\n                                <h2 class=\"accordion-header\" id=\"heading3\">\r\n                                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\r\n                                        <span><i class=\"fa-solid fa-angle-down\"></i></span> Do I have to be a business to work with you, or can individuals use these services too?\n                                    </button>\r\n                                </h2>\r\n                                <div id=\"collapse3\" class=\"accordion-collapse collapse\" aria-labelledby=\"heading3\" data-bs-parent=\"#accordionExample\">\r\n                                    <div class=\"accordion-body\">\r\n                                        <p>Both. We work with individual travellers and families just as much as importers and corporate clients &mdash; the service adjusts to what you need, not the other way round.</p>\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <!-- single item -->\r\n                            <div class=\"ca-iner-one accordion-item\">\r\n                                <h2 class=\"accordion-header\" id=\"heading4\">\r\n                                    <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\r\n                                        <span><i class=\"fa-solid fa-angle-down\"></i></span> I'm traveling to Guangzhou for the Canton Fair and also need to ship product samples home &mdash; is that a travel question or a trade question?\n                                    </button>\r\n                                </h2>\r\n                                <div id=\"collapse4\" class=\"accordion-collapse collapse\" aria-labelledby=\"heading4\" data-bs-parent=\"#accordionExample\">\r\n                                    <div class=\"accordion-body\">\r\n                                        <p>Both, and that's a combination we see often. Tell us the whole trip &mdash; we'll work out which parts are travel and which are trade, not you.</p>\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <section class=\"ca-faq-iner2 pt-100 pb-70\">\r\n        <div class=\"container\">\r\n            <div class=\"ca-about-content-3 ca-sec-content-3 text-center mb-60\">\r\n                <h5 class=\"ca-section-subtitle subtitle-bg-6 p-relative theme-color-3 br-50\">FAQ'S</h5>\r\n                <h2 class=\"ca-section-title theme-black-3 fnw-600 pt-16 ca-text-cap\">Answers to <em>Your Questions</em></h2>\n            </div>\r\n\r\n            <div class=\"row\">\r\n                <div class=\"col-lg-12\">\r\n                    <div class=\"ca-faq-acc\">\r\n                        <div class=\"ca-accordion\" id=\"accordionExample1\">\r\n                            <div class=\"row\">\r\n                                <div class=\"col-lg-6\">\r\n                                    <div class=\"accordion\" id=\"accordionExample2\">\r\n\r\n                                        <!-- single acordion item -->\r\n                                        <div class=\"ca-iner-accordion-item\">\r\n                                            <h2 class=\"accordion-header\">\r\n                                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseTwo\" aria-expanded=\"false\" aria-controls=\"collapseTwo\">\r\n                                                    Your packages show pricing based on a minimum of two people &mdash; what happens if I'm traveling solo?\n                                                </button>\r\n                                            </h2>\r\n                                            <div id=\"collapseTwo\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionExample1\">\r\n                                                <div class=\"accordion-body\">\r\n                                                    <p>Solo travel just needs a different quote. The per-person cost changes, but it's not a reason we'd turn the trip away &mdash; tell us it's just you and we'll price it accordingly.</p>\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                        <!-- single acordion item -->\r\n                                        <div class=\"ca-iner-accordion-item\">\r\n                                            <h2 class=\"accordion-header\">\r\n                                                <button class=\"accordion-button\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseOne\" aria-expanded=\"true\" aria-controls=\"collapseOne\">\r\n                                                    I don't have every document ready yet &mdash; bank statements, employer letter, all of it &mdash; can I still start, or do I need everything upfront?\n                                                </button>\r\n                                            </h2>\r\n                                            <div id=\"collapseOne\" class=\"accordion-collapse collapse show\" data-bs-parent=\"#accordionExample1\">\r\n                                                <div class=\"accordion-body\">\r\n                                                    <p>You can start with what you have. We'll tell you exactly what's still missing and by when, instead of leaving you to guess.</p>\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n\r\n\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"col-lg-6\">\r\n                                    <div class=\"accordion\" id=\"accordionExample3\">\r\n                                        <!-- single acordion item -->\r\n                                        <div class=\"ca-iner-accordion-item\">\r\n                                            <h2 class=\"accordion-header\">\r\n                                                <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#collapseFive\" aria-expanded=\"false\" aria-controls=\"collapseFive\">\r\n                                                    Is pricing fixed, or does it depend on my request?\n                                                </button>\r\n                                            </h2>\r\n                                            <div id=\"collapseFive\" class=\"accordion-collapse collapse\" data-bs-parent=\"#accordionExample3\">\r\n                                                <div class=\"accordion-body\">\r\n                                                    <p>It depends on the service &mdash; a visa, a shipment, and a sourcing order all price differently. We'll always give you clear numbers before you commit to anything, not after.</p>\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n\r\n                                    </div>\r\n\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </section>\r\n</main>\r\n\r\n\r\n    <footer class=\"travlink-footer\">\n    <div class=\"container\">\n        <div class=\"travlink-footer__top\">\n            <div class=\"travlink-footer__brand\">\n                <a class=\"travlink-footer__logo\" href=\"/\" aria-label=\"Travlink Global home\">\n                    <span class=\"travlink-footer__logo-mark\" aria-hidden=\"true\"><i class=\"fa-solid fa-globe\"></i></span>\n                    <span>Travlink Global</span>\n                </a>\n                <p class=\"travlink-footer__description\">Connecting people and businesses across borders through trusted travel, trade, and shipping solutions.</p>\n                <div class=\"travlink-footer__socials\" aria-label=\"Social media links\">\n                    <a href=\"#\" aria-label=\"Instagram\"><i class=\"fa-brands fa-instagram\"></i></a>\n                    <a href=\"#\" aria-label=\"Facebook\"><i class=\"fa-brands fa-facebook-f\"></i></a>\n                    <a href=\"#\" aria-label=\"LinkedIn\"><i class=\"fa-brands fa-linkedin-in\"></i></a>\n                    <a href=\"#\" aria-label=\"X\"><i class=\"fa-brands fa-x-twitter\"></i></a>\n                </div>\n            </div>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer quick links\">\n                <h2>Quick Links</h2>\n                <ul>\n                    <li><a href=\"/\">Home</a></li>\n                    <li><a href=\"/about/\">About</a></li>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                    <li><a href=\"/contact/\">Contact</a></li>\n                </ul>\n            </nav>\n\n            <nav class=\"travlink-footer__column\" aria-label=\"Footer services\">\n                <h2>Services</h2>\n                <ul>\n                    <li><a href=\"/travel/\">Travel</a></li>\n                    <li><a href=\"/trade/\">Trade</a></li>\n                    <li><a href=\"/shipping/\">Shipping</a></li>\n                </ul>\n            </nav>\n\n            <div class=\"travlink-footer__column travlink-footer__contact\">\n                <h2>Contact &amp; Legal</h2>\n                <ul>\n                    <li><a href=\"https://wa.me/\" target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>WhatsApp</a></li>\n                    <li><a href=\"mailto:infotravlinkglobal@gmail.com\"><i class=\"fa-regular fa-envelope\" aria-hidden=\"true\"></i>Travlinkglobal@gmail.com </a></li>\n                </ul>\n            </div>\n        </div>\n\n        <div class=\"travlink-footer__bottom\">\n            <p class=\"travlink-footer__copyright\">&copy; 2026 Travlink Global. All rights reserved.</p>\n            <nav class=\"travlink-footer__legal\" aria-label=\"Legal links\">\n                <a href=\"#\">Privacy Policy</a>\n                <a href=\"#\">Terms &amp; Conditions</a>\n            </nav>\n        </div>\n    </div>\n</footer>\n\n\r\n    <button id=\"topBtn3\"><i class=\"fa-solid fa-arrow-up\"></i></button>\r\n    <a class=\"travlink-whatsapp-float\"\n   href=\"https://wa.me/\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\"\n   aria-label=\"Contact Travlink Global on WhatsApp\">\n    <i class=\"fa-brands fa-whatsapp\" aria-hidden=\"true\"></i>\n</a>\r\n\r\n    <script src=\"/js/jquery-3.7.1.min.js\"></script>\r\n<script src=\"/js/bootstrap.bundle.min.js\"></script>\r\n<script src=\"/js/jquery.magnific-popup.min.js\"></script>\r\n<script src=\"/js/jquery.counterup.min.js\"></script>\r\n<script src=\"/js/slick.min.js\"></script>\r\n<script src=\"/js/jquery.nice-select.js\"></script>\r\n<script src=\"/js/waypoints.min.js\"></script>\r\n<script src=\"/js/aos.js\"></script>\r\n<script src=\"/js/main.js\"></script>\r\n<script src=\"/js/scroll-motion.js\"></script>\r\n<script src=\"/js/mobile-navigation.js\"></script>\r\n\r\n\r\n    \r\n\r\n\r\n\r\n"
