@{
    ViewBag.Title = "Trade";
    ViewBag.BodyClass = "travlink-trade-page-body";
}

@section styles
{
    <link rel="stylesheet" href="~/css/trade-service.css" asp-append-version="true" />
}

<main class="travlink-trade-page">
    <section class="travlink-trade-hero" aria-labelledby="trade-hero-title">
        <div class="travlink-trade-hero__content container">
            <span class="travlink-trade-hero__label">Trade</span>
            <h1 id="trade-hero-title">Sourcing done right <span>&mdash;</span><br>from factory floor to final delivery.</h1>
        </div>
    </section>

    <section class="travlink-trade-services" aria-labelledby="trade-services-title">
        <div class="container">
            <div class="travlink-trade-services__layout">
                <div class="travlink-trade-services__intro">
                    <span class="travlink-trade-eyebrow">Trade Services</span>
                    <h2 id="trade-services-title">From the right supplier to the final delivery.</h2>
                    <img src="~/img/service/ca-service-bg-2.1.png" alt="International trade and sourcing coordination">
                </div>
                <div class="travlink-trade-services__list">
                    <article><i class="fa-solid fa-box-open" aria-hidden="true"></i><h3>Product Sourcing</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-handshake" aria-hidden="true"></i><h3>Supplier Identification</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><h3>Supplier Verification</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-industry" aria-hidden="true"></i><h3>Factory Coordination</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i><h3>Import Consultation</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i><h3>Export Consultation</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-users" aria-hidden="true"></i><h3>Business Networking</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                    <article><i class="fa-solid fa-globe" aria-hidden="true"></i><h3>International Procurement</h3><span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></article>
                </div>
            </div>
        </div>
    </section>

    <section class="travlink-trade-support" aria-label="Trade consultation and frequently asked questions">
        <div class="container">
            <div class="travlink-trade-support__grid">
                <aside class="travlink-trade-contact">
                    <span class="travlink-trade-eyebrow">Contact Us</span>
                    <h2>Request Trade Consultation</h2>
                    <form class="travlink-trade-contact__form" action="#">
                        <input type="text" placeholder="Your Name" aria-label="Your Name">
                        <input type="email" placeholder="Email Address" aria-label="Email Address">
                        <input type="tel" placeholder="Phone Number" aria-label="Phone Number">
                        <textarea rows="5" placeholder="Your Message" aria-label="Your Message"></textarea>
                        <button class="ca-btn-primary-3 theme-bg-3 text-white br-50" type="submit">Send Inquiry <span><i class="fa-solid fa-angle-right"></i></span></button>
                    </form>
                    <div class="travlink-trade-contact__socials" aria-label="Social media links">
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </aside>
                <div class="travlink-trade-faq">
                    <div class="travlink-trade-faq__heading">
                        <span class="travlink-trade-eyebrow">Trade FAQs</span>
                        <h2>Questions, answered clearly.</h2>
                    </div>
                    <div class="ca-acordion-area travlink-trade-faq__accordion">
                        <div class="accordion" id="tradeFaqAccordion">
                            <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                                <h3 class="ca-accordion-header" id="tradeFaqOne"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#tradeFaqOneContent" aria-expanded="true" aria-controls="tradeFaqOneContent">Which countries do you source from?</button></h3>
                                <div id="tradeFaqOneContent" class="accordion-collapse collapse show" aria-labelledby="tradeFaqOne" data-bs-parent="#tradeFaqAccordion"><div class="ca-accordion-body"><p>Primarily China and Vietnam, with a growing network across Asia.</p></div></div>
                            </div>
                            <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                                <h3 class="ca-accordion-header" id="tradeFaqTwo"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tradeFaqTwoContent" aria-expanded="false" aria-controls="tradeFaqTwoContent">Can you verify a supplier before I commit?</button></h3>
                                <div id="tradeFaqTwoContent" class="accordion-collapse collapse" aria-labelledby="tradeFaqTwo" data-bs-parent="#tradeFaqAccordion"><div class="ca-accordion-body"><p>Yes &mdash; supplier verification is part of our process.</p></div></div>
                            </div>
                            <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                                <h3 class="ca-accordion-header" id="tradeFaqThree"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tradeFaqThreeContent" aria-expanded="false" aria-controls="tradeFaqThreeContent">Do you help with factory visits?</button></h3>
                                <div id="tradeFaqThreeContent" class="accordion-collapse collapse" aria-labelledby="tradeFaqThree" data-bs-parent="#tradeFaqAccordion"><div class="ca-accordion-body"><p>Yes, we coordinate visits and communication on the ground.</p></div></div>
                            </div>
                            <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                                <h3 class="ca-accordion-header" id="tradeFaqFour"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tradeFaqFourContent" aria-expanded="false" aria-controls="tradeFaqFourContent">Is there a minimum order size?</button></h3>
                                <div id="tradeFaqFourContent" class="accordion-collapse collapse" aria-labelledby="tradeFaqFour" data-bs-parent="#tradeFaqAccordion"><div class="ca-accordion-body"><p>It depends on the supplier &mdash; we'll help you understand what's realistic.</p></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
