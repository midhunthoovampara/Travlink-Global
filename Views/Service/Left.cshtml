@{
    ViewBag.Title = "Travel";
    ViewBag.BodyClass = "travlink-travel-page-body";
    var showYachtExperiences = true;
}

@section styles
{
    <link rel="stylesheet" href="~/css/travel-service.css" asp-append-version="true" />
}

<main class="travlink-travel-page">
    <section class="travlink-travel-hero" aria-labelledby="travel-hero-title">
        <div class="travlink-travel-hero__content container">
            <span class="travlink-travel-hero__label">Travel</span>
            <h1 id="travel-hero-title">Travel, planned around you <span>&mdash;</span><br>from your first visa to your next holiday.</h1>
        </div>
    </section>

    <section class="travlink-travel-selector" aria-labelledby="travel-service-selector-title">
        <div class="container">
            <header class="travlink-travel-selector__header">
                <span class="travlink-travel-eyebrow">Our Travel Services</span>
                <h2 id="travel-service-selector-title">Choose the Service <em>You Need</em></h2>
                <p>Travel planning and visa support, available in one place.</p>
            </header>

            <div class="travlink-travel-selector__grid">
                <a class="travlink-travel-selector__card" href="#travel-packages" aria-label="Explore Travel Packages">
                    @* <span class="travlink-travel-selector__number">01</span> *@
                    <h3>Travel Packages</h3>
                    <i class="fa-solid fa-arrow-right travlink-travel-selector__arrow" aria-hidden="true"></i>
                </a>

                <a class="travlink-travel-selector__card" href="#visa-assistance" aria-label="Explore Visa Assistance">
                    @* <span class="travlink-travel-selector__number">2</span> *@
                    <h3>Visa Assistance</h3>
                    <i class="fa-solid fa-arrow-right travlink-travel-selector__arrow" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </section>

    <section class="travlink-travel-features" aria-label="Travel packages and visa assistance">
        <div class="container">
            <article class="travlink-travel-feature travlink-travel-feature--packages" id="travel-packages" aria-labelledby="travel-packages-title">
                <div class="travlink-travel-feature__image">
                    <img src="~/img/service/travell.jpg" alt="Airplane wing above a city skyline, representing international travel" />
                </div>
                <div class="travlink-travel-feature__content">
                    <span class="travlink-travel-eyebrow">Travel Packages</span>
                    @* <span class="travlink-travel-feature__tag">Travel Service 01</span> *@
                    <h2 id="travel-packages-title">Holidays, business trips, <em>and everything in between.</em></h2>
                    <div class="travlink-package-list">
                        <article class="travlink-package-item"><i class="fa-regular fa-map" aria-hidden="true"></i><div><h3>International Tour Packages</h3></div></article>
                        <article class="travlink-package-item"><i class="fa-solid fa-bed" aria-hidden="true"></i><div><h3>Hotel Bookings</h3></div></article>
                        <article class="travlink-package-item"><i class="fa-solid fa-car-side" aria-hidden="true"></i><div><h3>Airport Transfers</h3></div></article>
                        @if (showYachtExperiences)
                        {
                            <article class="travlink-package-item"><i class="fa-solid fa-anchor" aria-hidden="true"></i><div><h3> Leisure Activities</h3></div></article>
                        }
                        <article class="travlink-package-item"><i class="fa-regular fa-calendar" aria-hidden="true"></i><div><h3>Holiday Planning</h3></div></article>
                        <article class="travlink-package-item"><i class="fa-solid fa-briefcase" aria-hidden="true"></i><div><h3>Business Travel</h3></div></article>
                        <article class="travlink-package-item"><i class="fa-solid fa-route" aria-hidden="true"></i><div><h3>Customized Itineraries</h3></div></article>
                    </div>
                </div>
            </article>

            <article class="travlink-travel-feature travlink-travel-feature--visa" id="visa-assistance" aria-labelledby="visa-title">
                <div class="travlink-travel-feature__content">
                    <span class="travlink-travel-eyebrow">Visa Assistance</span>
                    @* <span class="travlink-travel-feature__tag">Travel Service 02</span> *@
                    <h2 id="visa-title">Getting the paperwork right, <em>the first time.</em></h2>
                    <div class="travlink-visa__types">
                        <article class="travlink-visa-card"><i class="fa-solid fa-passport" aria-hidden="true"></i><h3>Tourist Visa</h3></article>
                        <article class="travlink-visa-card"><i class="fa-solid fa-briefcase" aria-hidden="true"></i><h3>Business Visa</h3></article>
                        <article class="travlink-visa-card"><i class="fa-solid fa-plane-departure" aria-hidden="true"></i><h3>Transit Visa</h3></article>
                    </div>
                    <section class="travlink-country-showcase" aria-labelledby="visa-country-title">
                        <span class="travlink-country-showcase__label">Countries We Assist</span>
                        <h3 id="visa-country-title">Visa Assistance <em>Across Multiple Destinations</em></h3>

                        <div class="travlink-country-carousel" role="region" aria-label="Countries supported for visa assistance">
                            <div class="travlink-country-carousel__track">
                                <div class="travlink-country-carousel__group">
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/qatar.jpg" width="760" height="500" loading="lazy" decoding="async" alt="Doha waterfront skyline in Qatar" />
                                        <span class="travlink-country-card__name">Qatar</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/kuwait.jpg" width="760" height="500" loading="lazy" decoding="async" alt="The Kuwait Towers in Kuwait City" />
                                        <span class="travlink-country-card__name">Kuwait</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/china.jpg" width="760" height="500" loading="lazy" decoding="async" alt="The Great Wall of China across mountain ridges" />
                                        <span class="travlink-country-card__name">China</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/uzbekistan.jpg" width="760" height="500" loading="lazy" decoding="async" alt="Historic tiled architecture in Samarkand, Uzbekistan" />
                                        <span class="travlink-country-card__name">Uzbekistan</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/kazakhstan.jpg" width="760" height="500" loading="lazy" decoding="async" alt="Bayterek Tower and modern architecture in Astana, Kazakhstan" />
                                        <span class="travlink-country-card__name">Kazakhstan</span>
                                    </article>
                                    <article class="travlink-country-card travlink-country-card--more">
                                        <i class="fa-solid fa-earth-asia" aria-hidden="true"></i>
                                        <span class="travlink-country-card__name">And More<small>Contact us for other destinations</small></span>
                                    </article>
                                </div>

                                <div class="travlink-country-carousel__group" aria-hidden="true">
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/qatar.jpg" width="760" height="500" loading="lazy" decoding="async" alt="" />
                                        <span class="travlink-country-card__name">Qatar</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/kuwait.jpg" width="760" height="500" loading="lazy" decoding="async" alt="" />
                                        <span class="travlink-country-card__name">Kuwait</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/china.jpg" width="760" height="500" loading="lazy" decoding="async" alt="" />
                                        <span class="travlink-country-card__name">China</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/uzbekistan.jpg" width="760" height="500" loading="lazy" decoding="async" alt="" />
                                        <span class="travlink-country-card__name">Uzbekistan</span>
                                    </article>
                                    <article class="travlink-country-card">
                                        <img src="~/img/service/countries/kazakhstan.jpg" width="760" height="500" loading="lazy" decoding="async" alt="" />
                                        <span class="travlink-country-card__name">Kazakhstan</span>
                                    </article>
                                    <article class="travlink-country-card travlink-country-card--more">
                                        <i class="fa-solid fa-earth-asia" aria-hidden="true"></i>
                                        <span class="travlink-country-card__name">And More<small>Contact us for other destinations</small></span>
                                    </article>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="travlink-travel-feature__image">
                    <img src="~/img/service/visa.jpg" alt="Passport and boarding pass prepared for international travel" />
                </div>
            </article>
        </div>
    </section>
    <section class="travlink-travel-support" aria-label="Travel consultation and frequently asked questions">
        <div class="container">
            <div class="travlink-travel-support__grid">
                <aside class="travlink-travel-contact">
                    <span class="travlink-travel-eyebrow">Contact Us</span>
                    <h2>Request Travel <em>Consultation</em></h2>
                    <form class="travlink-travel-contact__form" action="#">
                        <input type="text" placeholder="Your Name" aria-label="Your Name">
                        <input type="email" placeholder="Email Address" aria-label="Email Address">
                        <input type="tel" placeholder="Phone Number" aria-label="Phone Number">
                        <textarea rows="5" placeholder="Your Message" aria-label="Your Message"></textarea>
                        <button class="ca-btn-primary-3 theme-bg-3 text-white br-50" type="submit">Send Inquiry <span><i class="fa-solid fa-angle-right"></i></span></button>
                    </form>
                    <div class="travlink-travel-contact__socials" aria-label="Social media links">
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </aside>
                <div class="travlink-travel-faq">
                    <div class="travlink-travel-faq__heading">
                        <span class="travlink-travel-eyebrow">Travel FAQs</span>
                        <h2 id="travel-faq-title">Questions, <em>answered clearly.</em></h2>
                    </div>
                    <div class="ca-acordion-area travlink-travel-faq__accordion">                <div class="accordion" id="travelFaqAccordion">
                    <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                        <h3 class="ca-accordion-header" id="travelFaqOne"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#travelFaqOneContent" aria-expanded="true" aria-controls="travelFaqOneContent">How long does visa processing take?</button></h3>
                        <div id="travelFaqOneContent" class="accordion-collapse collapse show" aria-labelledby="travelFaqOne" data-bs-parent="#travelFaqAccordion"><div class="ca-accordion-body"><p>It depends on the country and visa type &mdash; we'll give you a clear timeline before you apply.</p></div></div>
                    </div>
                    <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                        <h3 class="ca-accordion-header" id="travelFaqTwo"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#travelFaqTwoContent" aria-expanded="false" aria-controls="travelFaqTwoContent">Do you book flights and hotels together?</button></h3>
                        <div id="travelFaqTwoContent" class="accordion-collapse collapse" aria-labelledby="travelFaqTwo" data-bs-parent="#travelFaqAccordion"><div class="ca-accordion-body"><p>Yes, we can handle your full itinerary in one place.</p></div></div>
                    </div>
                    <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                        <h3 class="ca-accordion-header" id="travelFaqThree"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#travelFaqThreeContent" aria-expanded="false" aria-controls="travelFaqThreeContent">Can you help with last-minute business travel?</button></h3>
                        <div id="travelFaqThreeContent" class="accordion-collapse collapse" aria-labelledby="travelFaqThree" data-bs-parent="#travelFaqAccordion"><div class="ca-accordion-body"><p>Yes &mdash; reach out and we'll move quickly.</p></div></div>
                    </div>
                    <div class="ca-accordion-item ca-accordion-item-2 mb-24">
                        <h3 class="ca-accordion-header" id="travelFaqFour"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#travelFaqFourContent" aria-expanded="false" aria-controls="travelFaqFourContent">Do you offer group travel packages?</button></h3>
                        <div id="travelFaqFourContent" class="accordion-collapse collapse" aria-labelledby="travelFaqFour" data-bs-parent="#travelFaqAccordion"><div class="ca-accordion-body"><p>Yes, for families, corporate teams, and small groups.</p></div></div>
                    </div>
                </div>                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

