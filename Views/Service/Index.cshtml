{

}

<main>
    <!-- breadcrumb area start -->
    <section class="ca-breadcrumb-area cream-bg-3 p-relative z-index-1 fix">
        <div class="ca-breadcrumb-shape p-absolute bre-sh-1">
            <img src="~/img/shape/breadcrumn-shape.png" alt="">
        </div>
        <div class="ca-breadcrumb-shape p-absolute bre-sh-2">
            <img src="~/img/shape/ca-line-shape.png" alt="">
        </div>
        <div class="container">
            <div class="ca-breadcrumb-content text-center">
                <h2 class="ca-breadcrumb-title fnw-600">Our Services</h2>
                <div class="it-breadcum-link">
                    <a href="#">Home</a>
                    <span><i class="fa-solid fa-angle-right"></i></span>
                    <a class="active" href="#">Our Services</a>
                </div>
            </div>
        </div>
    </section>
    <!-- breadcrumb area end -->

    <!-- service area start -->
    <div class="ca-iner-servics pt-100 pb-100">
        <div class="container">
            <div class="row">

                <!-- Travel Service -->
                <div class="col-xl-4 col-md-6 mb-30">
                    <div class="ca-ser-icon-box ca-ser-icon-box-2 fix p-relative cream-bg-3 z-index-1 p-32 br-7">
                        <div class="ca-about-icon">
                            <div class="ca-about-ic ca-ser-ic">
                                <img src="~/img/icon/ca-iner-ser1.1.svg" alt="">
                            </div>
                            <div class="ca-num">
                                <h4 class="overly-num overly-num2">01</h4>
                            </div>
                        </div>
                        <div class="ca-service-content ca-service-content-iner">
                            <h4 class="ca-title fnw-700 pb-16 pt-32">
                                <a href=@Url.Action("Single", "Service")>Travel Services</a>
                            </h4>
                            <p class="pb-24">
                                Explore Asia with confidence through our international tour packages,
                                visa assistance, hotel bookings, airport transfers, and customized
                                travel experiences for leisure and business travelers.
                            </p>
                            <a href=@Url.Action("Left", "Service") class="read-more">
                                Read More <span><i class="fa-solid fa-angle-right"></i></span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Trade Service -->
                <div class="col-xl-4 col-md-6 mb-30">
                    <div class="ca-ser-icon-box ca-ser-icon-box-2 fix p-relative cream-bg-3 z-index-1 p-32 br-7">
                        <div class="ca-about-icon">
                            <div class="ca-about-ic ca-ser-ic">
                                <img src="~/img/icon/ca-iner-ser1.2.svg" alt="">
                            </div>
                            <div class="ca-num">
                                <h4 class="overly-num overly-num2">02</h4>
                            </div>
                        </div>
                        <div class="ca-service-content ca-service-content-iner">
                            <h4 class="ca-title fnw-700 pb-16 pt-32">
                                <a href=@Url.Action("Right", "Service")>Trade Solutions</a>
                            </h4>
                            <p class="pb-24">
                                Connect with trusted suppliers across Asia through supplier sourcing,
                                factory visits, business matchmaking, and import-export consulting
                                tailored to your business goals.
                            </p>
                            <a href=@Url.Action("Right", "Service") class="read-more">
                                Read More <span><i class="fa-solid fa-angle-right"></i></span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Logistics Service -->
                <div class="col-xl-4 col-md-6 mb-30">
                    <div class="ca-ser-icon-box ca-ser-icon-box-2 fix p-relative cream-bg-3 z-index-1 p-32 br-7">
                        <div class="ca-about-icon">
                            <div class="ca-about-ic ca-ser-ic">
                                <img src="~/img/icon/ca-iner-ser1.3.svg" alt="">
                            </div>
                            <div class="ca-num">
                                <h4 class="overly-num overly-num2">03</h4>
                            </div>
                        </div>
                        <div class="ca-service-content ca-service-content-iner">
                            <h4 class="ca-title fnw-700 pb-16 pt-32">
                                <a href=@Url.Action("Single", "Service")>Logistics Support</a>
                            </h4>
                            <p class="pb-24">
                                We coordinate reliable shipping, freight forwarding, customs support,
                                and cargo movement through our trusted logistics partners across Asia,
                                ensuring smooth cross-border operations.
                            </p>
                            <a href=@Url.Action("Single", "Service") class="read-more">
                                Read More <span><i class="fa-solid fa-angle-right"></i></span>
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
