@section scripts
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const cards = Array.from(document.querySelectorAll('.travlink-service-card'));
            const usesTap = window.matchMedia('(hover: none)').matches;

            function setCardState(card, active) {
                card.classList.toggle('is-active', active);
                card.setAttribute('aria-expanded', active ? 'true' : 'false');
            }

            cards.forEach(function (card) {
                card.addEventListener('click', function (event) {
                    if (!usesTap || event.target.closest('a')) return;

                    const shouldOpen = !card.classList.contains('is-active');
                    cards.forEach(function (item) { setCardState(item, false); });
                    setCardState(card, shouldOpen);
                });

                card.addEventListener('keydown', function (event) {
                    if (event.key !== 'Enter' && event.key !== ' ') return;
                    if (event.target.closest('a')) return;

                    event.preventDefault();
                    const shouldOpen = !card.classList.contains('is-active');
                    cards.forEach(function (item) { setCardState(item, false); });
                    setCardState(card, shouldOpen);
                });
            });

            document.addEventListener('click', function (event) {
                if (!usesTap || event.target.closest('.travlink-service-card')) return;
                cards.forEach(function (card) { setCardState(card, false); });
            });
        });
    </script>
}


