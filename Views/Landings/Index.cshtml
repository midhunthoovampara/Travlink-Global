     <!-- process section start -->
    <section class="travlink-process" aria-labelledby="travlink-process-title">
        <div class="container">
            <div class="travlink-process__header ca-sec-content-3 text-center" data-aos="fade-up" data-aos-duration="700">
                <h5 class="ca-section-subtitle p-relative" ">Our Process</h5>
                <h5 class="ca-section-title fnw-600" id="travlink-process-title">A Simple Process, Built Around You</h5>
                 @* <p>From your first enquiry to final delivery, we keep every step clear, personal, and well managed.</p> *@
            </div> 

            <div class="travlink-process__grid">
                <article class="travlink-process__step" data-aos="fade-up" data-aos-delay="0" data-aos-duration="650">
                    <span class="travlink-process__number">01</span>
                    <h3>Contact Us</h3>
                    <p>Reach out with what you need&mdash;travel, trade, or shipping.</p>
                </article>

                <article class="travlink-process__step" data-aos="fade-up" data-aos-delay="100" data-aos-duration="650">
                    <span class="travlink-process__number">02</span>
                    <h3>Tell Us Your Requirement</h3>
                    <p>Share the details. We&rsquo;ll ask the right questions.</p>
                </article>

                <article class="travlink-process__step" data-aos="fade-up" data-aos-delay="200" data-aos-duration="650">
                    <span class="travlink-process__number">03</span>
                    <h3>We Plan the Best Solution</h3>
                    <p>A plan built around your requirement, not a fixed package.</p>
                </article>

                <article class="travlink-process__step" data-aos="fade-up" data-aos-delay="300" data-aos-duration="650">
                    <span class="travlink-process__number">04</span>
                    <h3>We Deliver the Service</h3>
                    <p>From first enquiry to final delivery, we stay involved.</p>
                </article>
            </div>
        </div>
    </section>
    <!-- process section end -->

     <!-- about section start -->
    <section class="ca-about-3 travlink-about-editorial" aria-labelledby="travlink-about-title">
        <div class="container">
            <div class="travlink-about-editorial__layout">
                <div class="travlink-about-editorial__collage" aria-label="Travlink Global across Asia and international markets">
                    <div class="travlink-about-editorial__column travlink-about-editorial__column--left">
                        <figure class="travlink-about-editorial__image travlink-about-editorial__image--large">
                            <img src="~/img/about/abt1.png" alt="International flight viewed above the clouds">
                            <figcaption><span class="counter">8</span>+ Asian Countries</figcaption>
                        </figure>
                        <figure class="travlink-about-editorial__image travlink-about-editorial__image--small">
                            <img src="~/img/service/trade.jpg" alt="International business partners completing a trade agreement">
                            <figcaption>Global Trade</figcaption>
                        </figure>
                    </div>
                    <div class="travlink-about-editorial__column travlink-about-editorial__column--right">
                        <figure class="travlink-about-editorial__image travlink-about-editorial__image--small">
                            <img src="~/img/faq/faq1.jpeg" alt="Container ship sailing at sunset">
                            <figcaption>Ocean Shipping</figcaption>
                        </figure>
                        <figure class="travlink-about-editorial__image travlink-about-editorial__image--large">
                            <img src="~/img/service/tt.jpg" alt="Modern warehouse and global supply chain operation">
                            <figcaption>Global Supply Chain</figcaption>
                        </figure>
                    </div>
                </div>
                <div class="travlink-about-editorial__content">
                    <span class="travlink-about-editorial__eyebrow">About Us</span>
                    <h2 id="travlink-about-title">Built for journeys, trade, and movement across borders.</h2>
                    <div class="travlink-about-editorial__copy">
                        <p>Travlink Global is a travel, trade, and shipping company built on founder-led experience &mdash; in visa facilitation, sourcing, and travel planning. We bring that experience together under one platform, built for people and businesses who want things handled properly, without the noise.</p>
                        <p>We focus on creating seamless global experiences while staying professional, transparent, and genuinely useful to the people we work with.</p>
                    </div>
                    <p class="travlink-about-editorial__note">Travlink Global is a brand operated by Deacon Trading Company, India.</p>
                    <div class="ca-about-3-btn">
                        <a href=@Url.Action("About", "Pages") class="travlink-about-editorial__button">About Travlink Global <span><i class="fa-solid fa-angle-right"></i></span></a>
                    </div>
                </div>
            </div>
        </div>
    </section>    <!-- about section end -->
